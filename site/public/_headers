/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self' https://admin.quantritute.com https://quantritute-admin.pages.dev; upgrade-insecure-requests; object-src 'none'; base-uri 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/assets/fonts/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

# 12/11/2026: dữ liệu câu chuyện gốc của trò chơi – trang Quản trị (tên miền admin) đọc để hiện bản gốc khi sửa
/tro-choi/*/du-lieu.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
