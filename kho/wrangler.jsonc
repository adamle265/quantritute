{
  // Cấu hình Cloudflare cho dự án "quantritute-kho" – Kho nghiên cứu + Sổ tay riêng của anh Tuấn (có mật khẩu).
  // Dùng chung database quantritute-db (bảng riêng tiền tố kho_) để lệnh sao-luu.cmd sao lưu luôn sổ tay.
  "name": "quantritute-kho",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "quantritute-db", "database_id": "f67070cc-9dd8-4c8d-9707-e8078619caf6" }
  ]
}
