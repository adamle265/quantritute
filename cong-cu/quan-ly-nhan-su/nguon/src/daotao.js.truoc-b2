        { id: 't2', ten: 'Bài kiểm tra cuối khóa', gan: { l: 'khoa', id: '' }, tg: 15, cau: [dtQ('q3', 'mot', 'Có thắc mắc về hồ sơ, hợp đồng, bảo hiểm, bạn hỏi ai trước?', ['Phòng nhân sự', 'Bất kỳ đồng nghiệp nào', 'Giám đốc'], [0]), dtQ('q4', 'nhieu', 'Việc nào đúng với nội quy?', ['Đi muộn phải báo trưởng bộ phận', 'Được mang dữ liệu khách hàng về máy cá nhân', 'Giữ gìn thiết bị được giao'], [0, 2], 2), dtQ('q5', 'tl', 'Vì sao phải giữ bí mật thông tin khách hàng, học viên? Nêu 1 việc cụ thể bạn sẽ làm.', null, null, 2, 'Nêu được: tôn trọng quyền riêng tư, tránh rủi ro pháp lý, giữ uy tín công ty; việc cụ thể như không chụp màn hình gửi ra ngoài, khóa máy khi rời chỗ.')] }
      ],
