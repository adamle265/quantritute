  /* =====================================================================
     MODULE ĐÀO TẠO NỘI BỘ (bổ sung vào bản 0.6.1 – bắt đầu 12/11/2026 15:16)
     Anh Tuấn chốt 12/11 15:16: video chỉ dán link; bài kiểm tra có tự luận, chọn 1, chọn nhiều; chưa làm đào tạo bên ngoài,
     mẫu ATVSLĐ, điểm danh. 16:01 anh yêu cầu tối ưu trình soạn khóa học:
       - 4 tab: Thông tin khóa học · Bài giảng · Bài kiểm tra · Cài đặt
       - Thông tin: tên, thời lượng dự kiến, giảng viên, đối tượng phù hợp, ảnh bìa, video giới thiệu (link), giới thiệu, lợi ích, học phí (miễn phí / trả phí + số tiền)
       - Bài giảng 2 cấp: Chương / chủ đề (chữ) → bài học: Bài đọc, Tài liệu, Video
       - Bài kiểm tra gắn sau 1 bài, cuối chương hoặc cuối khóa
       - Soạn nội dung bằng khung soạn thảo như Hợp đồng (TipTap) + trường liên kết dữ liệu có sẵn trên hệ thống, bấm vào trường xem giá trị mới nhất
       - Cài đặt: trạng thái, cách chấm điểm, cách tính hoàn thành bài học (xác nhận bài đọc, % xem video, điểm bài kiểm tra cuối bài),
         cách tính hoàn thành khóa học (% bài học, điểm bài kiểm tra cuối khóa); giữ phần giao cho ai, hạn, học lại định kỳ.
     Dữ liệu: khóa học lưu chung S.settings.dtKh; kết quả theo công ty u.dt.kq[Mã NV][mã khóa] =
       { bd, xong, bai: [mã bài đã xong], tests: { mã bài KT: { ans, tl, pct, lan, at } }, xn, tay, ghi }
     ===================================================================== */
  var DT_SEED = '2026-11-12b', DTV = 0, DT_ED = [];
  var DT_COL = ['#3F6B35', '#1F5F8B', '#8A4B9C', '#B4562B', '#2B6F77', '#A76300'];
  var DT_QT = { mot: 'Trắc nghiệm – chọn 1', nhieu: 'Trắc nghiệm – chọn nhiều', tl: 'Tự luận' };
  var DT_BT = { doc: 'Bài đọc', link: 'Tài liệu', video: 'Video' };
  var DT_TLD = [['phut', 'phút'], ['gio', 'giờ'], ['buoi', 'buổi'], ['ngay', 'ngày']];
  var DT_ST = { chua: ['Chưa học', 'mute'], hoc: ['Đang học', 'info'], cho: ['Chờ chấm', 'warn'], dat: ['Hoàn thành', 'ok'], khong: ['Chưa đạt', 'bad'], lai: ['Cần học lại', 'warn'] };
  var DT_DOW = { 1: 'Thứ Hai', 2: 'Thứ Ba', 3: 'Thứ Tư', 4: 'Thứ Năm', 5: 'Thứ Sáu', 6: 'Thứ Bảy', 0: 'Chủ nhật' };

  // Menu: Đào tạo nội bộ thành nhóm riêng có 2 mục
  (function () {
    var i = MODS.map(function (m) { return m.id; }).indexOf('daotao');
    var items = [
      { id: 'dtkhoa', g: 'dt', t: 'Kho khóa học', st: 'ok', k: 'dao tao noi bo khoa hoc bai giang chuong bai hoc video bai kiem tra trac nghiem tu luan noi quy' },
      { id: 'dtketqua', g: 'dt', t: 'Theo dõi học tập', st: 'ok', k: 'dao tao ket qua hoc tap ai da hoc cham bai tu luan qua han hoc lai' }
    ];
    if (i >= 0) MODS.splice.apply(MODS, [i, 1].concat(items)); else MODS.push.apply(MODS, items);
    var gi = GROUPS.map(function (g) { return g.id; }).indexOf('hn'); if (gi < 0) gi = GROUPS.map(function (g) { return g.id; }).indexOf('td');
    GROUPS.splice(gi + 1, 0, { id: 'dt', t: 'Đào tạo nội bộ', d: 'Khóa học nội bộ, ai đã học gì, ai còn phải học.' });
    var ti = TREE.indexOf('daotao'); if (ti >= 0) TREE[ti] = 'dt';
    IC.g_dt = IC.daotao; IC.dtkhoa = IC.daotao;
    IC.dtketqua = '<rect x="4" y="3.5" width="16" height="17" rx="2"/><path d="M8 8.5h8M8 12.5h5"/><path d="m13.5 16.5 1.8 1.8 3.2-3.3"/>';
    IC.dt_play = '<circle cx="12" cy="12" r="8.5"/><path d="m10 8.8 5.2 3.2-5.2 3.2z"/>';
    IC.dt_doc = '<path d="M7 3.5h7l4 4V20a.5.5 0 0 1-.5.5h-10A.5.5 0 0 1 7 20z"/><path d="M14 3.5V8h4M9.5 12h5M9.5 15.5h5"/>';
    IC.dt_link = '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>';
    IC.dt_quiz = '<circle cx="12" cy="12" r="8.5"/><path d="M9.6 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .8-1 1.5v.4M12 16.6v.1"/>';
    IC.dt_pause = '<circle cx="12" cy="12" r="8.5"/><path d="M10 9v6M14 9v6"/>';
    IC.dt_sign = '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8.5 12.3 2.4 2.4 4.6-4.9"/>';
    IC.dt_flag = '<path d="M5 21V4.5M5 4.5h11l-2 4 2 4H5"/>';
    IC.dt_ok = '<circle cx="12" cy="12" r="8.5"/><path d="m8.5 12.3 2.4 2.4 4.6-4.9"/>';
    IC.dt_ch = '<path d="M4 5.5h6.5a2 2 0 0 1 2 2V20a1.5 1.5 0 0 0-1.5-1.5H4zM20 5.5h-6.5a2 2 0 0 0-2 2V20a1.5 1.5 0 0 1 1.5-1.5H20z"/>';
    IC.dt_img = '<rect x="3.5" y="5" width="17" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m4 17 5-4.5 4 3.5 3-2.5 4 3.5"/>';
    IC.dt_user = '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>';
  })();

  /* ---------------- Dữ liệu ---------------- */
  function dtId(p) { return p + Date.now().toString(36) + Math.random().toString(36).slice(2, 5); }
  function dtHasSample() { return S.units.some(function (u) { return u.source === 'sample'; }); }
  function dtCd(k) {
    var d = k.cd = k.cd || {};
    if (d.on === undefined) d.on = true; if (d.bb === undefined) d.bb = true; if (!d.sc) d.sc = { us: [], pb: [], cd: [], moi: false };
    ['us', 'pb', 'cd'].forEach(function (x) { if (!d.sc[x]) d.sc[x] = []; });
    if (d.han === undefined) d.han = 14; if (d.lap === undefined) d.lap = 0; if (!d.giao) d.giao = HR.isoToday();
    if (!d.thang) d.thang = 10; if (!d.lay) d.lay = 'cao'; if (d.lan === undefined) d.lan = 0; if (d.dapan === undefined) d.dapan = true; if (d.tron === undefined) d.tron = false;
    d.hb = Object.assign({ doc: 'xn', link: 'mo', vid: 80, kt: d.thang === 100 ? 50 : 5 }, d.hb || {});
    d.hk = Object.assign({ pct: 100, kt: d.thang === 100 ? 70 : 7, xn: { on: false, nd: 'Tôi đã đọc, hiểu và cam kết thực hiện đúng nội dung khóa học.' } }, d.hk || {});
    return d;
  }
  // Chuyển khóa soạn ở bản trước (bài phẳng + 1 bài kiểm tra) sang cấu trúc chương / bài / nhiều bài kiểm tra
  function dtNorm(k) {
    if (!k.ch) {
      k.ch = [{ id: dtId('c'), t: 'Nội dung khóa học', mo: '', bai: (k.bai || []).map(function (b) { return { id: b.id, loai: b.loai, t: b.t, url: b.url || '', html: b.html || dtMdHtml(b.nd || ''), ph: 0 }; }) }];
      k.tests = k.kt && k.kt.on && k.kt.cau && k.kt.cau.length ? [{ id: dtId('t'), ten: 'Bài kiểm tra cuối khóa', gan: { l: 'khoa', id: '' }, tg: 0, cau: k.kt.cau }] : [];
      k.cd = { on: k.on !== false, bb: k.bb !== false, sc: k.sc, han: k.han, lap: k.lap, giao: k.giao, thang: 100, hk: { pct: 100, kt: k.kt ? +k.kt.dat || 0 : 0, xn: k.xn || { on: false, nd: '' } } };
      if (!k.gt && k.mo) k.gt = '<p>' + esc(k.mo) + '</p>';
      delete k.bai; delete k.kt; delete k.xn; delete k.on; delete k.bb; delete k.sc; delete k.han; delete k.lap; delete k.giao;
    }
    if (!k.tests) k.tests = []; if (!k.lt) k.lt = []; if (!k.hp) k.hp = { loai: 'free', so: 0 }; if (!k.tl) k.tl = { n: 0, dv: 'phut' };
    dtCd(k); return k;
  }
  function dtKh() {
    if (!Array.isArray(S.settings.dtKh) || (dtHasSample() && S.settings.dtSeed !== DT_SEED)) {
      var keep = Array.isArray(S.settings.dtKh) ? S.settings.dtKh.filter(function (k) { return !k.mau; }) : [];
      S.settings.dtKh = dtSample(dtHasSample()).concat(keep); S.settings.dtSeed = DT_SEED;
      try { saveSettings(); } catch (e) { }
    }
    S.settings.dtKh.forEach(dtNorm);
    return S.settings.dtKh;
  }
  function dtById(id) { return dtKh().filter(function (k) { return k.id === id; })[0] || null; }
  function dtOf(u) {
    if (!u.dt) u.dt = { v: 2, kq: {} }; if (!u.dt.kq) u.dt.kq = {};
    if (u.source === 'sample' && u.dt.seed !== DT_SEED) { u.dt.seed = DT_SEED; u.dt.kq = {}; try { dtSeedKq(u); } catch (e) { logErr('Tạo dữ liệu mẫu đào tạo', e); } }
    return u.dt;
  }
  function dtSave(txt) { DTV++; if (txt) log('Đào tạo nội bộ: ' + txt); saveSettings(); saveUnits(); }
  function dtUnitName(u) { return String(u.name || '').replace(/\s*\(dữ liệu mẫu\)\s*$/i, ''); }
  function dtAddM(iso, m) { var y = +iso.slice(0, 4), mo = +iso.slice(5, 7) - 1 + m, d = +iso.slice(8, 10); var t = new Date(Date.UTC(y, mo, 1)), last = new Date(Date.UTC(t.getUTCFullYear(), t.getUTCMonth() + 1, 0)).getUTCDate(); return t.getUTCFullYear() + '-' + p2(t.getUTCMonth() + 1) + '-' + p2(Math.min(d, last)); }
  function dtLessons(k) { var o = []; k.ch.forEach(function (c, ci) { c.bai.forEach(function (b, bi) { o.push({ c: c, b: b, ci: ci, bi: bi }); }); }); return o; }
  function dtNb(k) { return k.ch.reduce(function (a, c) { return a + c.bai.length; }, 0); }
  function dtTestsAt(k, l, id) { return k.tests.filter(function (t) { return t.gan.l === l && (l === 'khoa' || t.gan.id === id); }); }
  function dtGanTxt(k, t) {
    if (t.gan.l === 'khoa') return 'Cuối khóa học';
    if (t.gan.l === 'chuong') { var ci = k.ch.map(function (c) { return c.id; }).indexOf(t.gan.id); return ci < 0 ? 'Chưa gắn (chương đã xóa)' : 'Cuối chương ' + (ci + 1) + ': ' + k.ch[ci].t; }
    var x = dtLessons(k).filter(function (l) { return l.b.id === t.gan.id; })[0]; return x ? 'Sau bài ' + (x.ci + 1) + '.' + (x.bi + 1) + ': ' + x.b.t : 'Chưa gắn (bài đã xóa)';
  }
  function dtTlTxt(k) { return +k.tl.n ? k.tl.n + ' ' + (DT_TLD.filter(function (x) { return x[0] === k.tl.dv; })[0] || DT_TLD[0])[1] : ''; }
  function dtSum(k) { var t = document.createElement('div'); t.innerHTML = k.gt || ''; return (t.textContent || '').replace(/\s+/g, ' ').trim(); }
  // thang điểm: lưu điểm đạt theo thang của khóa (10 hoặc 100), tính bằng %
  function dtNeed(k, v) { return (+v || 0) / (dtCd(k).thang || 10) * 100; }
  function dtFmtS(k, pct) { var th = dtCd(k).thang || 10; if (pct == null) return '—'; var v = Math.round(pct / 100 * th * 10) / 10; return String(v).replace('.', ',') + '/' + th; }

  // Ai phải học khóa này
  function dtApplies(k, u, e) {
    var sc = dtCd(k).sc;
    if (sc.us.length && sc.us.indexOf(u.id) < 0) return false;
    if (sc.pb.length && sc.pb.indexOf(e['Phòng ban'] || '') < 0) return false;
    if (sc.cd.length && sc.cd.indexOf(e['Chức danh công việc'] || '') < 0) return false;
    if (sc.moi && !(e['Ngày vào làm'] && e['Ngày vào làm'] >= k.cd.giao)) return false;
    return true;
  }
  function dtScText(k) {
    var sc = dtCd(k).sc, a = [];
    a.push(sc.us.length ? sc.us.map(function (id) { var u = unitById(id); return u ? shortUnit(u.name) : ''; }).filter(Boolean).join(', ') : (S.units.length > 1 ? 'Tất cả công ty' : 'Toàn công ty'));
    if (sc.pb.length) a.push(sc.pb.length <= 2 ? sc.pb.join(', ') : sc.pb.length + ' phòng ban');
    if (sc.cd.length) a.push(sc.cd.length <= 2 ? sc.cd.join(', ') : sc.cd.length + ' vị trí');
    if (sc.moi) a.push('người mới vào');
    return a.join(' · ');
  }

  /* ---------------- Chấm điểm, tính hoàn thành ---------------- */
  function dtScoreT(t, ans, tl) {
    var got = 0, tot = 0, wait = false;
    (t.cau || []).forEach(function (q) {
      var d = +q.diem || 1; tot += d; var a = ans ? ans[q.id] : null;
      if (q.loai === 'tl') { var g = tl && tl[q.id]; if (g && g.d !== undefined && g.d !== '' && g.d !== null) got += Math.min(d, Math.max(0, +g.d)); else wait = true; return; }
      var ok = (q.dung || []).slice().sort().join(','), my = (a || []).slice().sort().join(',');
      if (ok && my === ok) got += d;
    });
    return { got: Math.round(got * 100) / 100, tot: tot, pct: tot ? Math.round(got / tot * 1000) / 10 : 100, wait: wait };
  }
  function dtPts(t) { return (t.cau || []).reduce(function (a, q) { return a + (+q.diem || 1); }, 0); }
  // Kết quả tổng hợp của 1 người với 1 khóa (theo Cài đặt: % bài học, điểm cuối bài, điểm cuối khóa, xác nhận)
  function dtEval(k, r) {
    var d = dtCd(k), L = dtLessons(k), done = r && r.bai || [], T = (r && r.tests) || {};
    var tPass = function (t, need) { var x = T[t.id]; if (!x || !x.ans) return null; var s = dtScoreT(t, x.ans, x.tl); if (s.wait) return 'wait'; return s.pct >= need ? 'ok' : 'bad'; };
    var items = 0, ok = 0, wait = false;
    L.forEach(function (l) { items++; var lt = dtTestsAt(k, 'bai', l.b.id), p = done.indexOf(l.b.id) >= 0 && lt.every(function (t) { var s = tPass(t, dtNeed(k, d.hb.kt)); if (s === 'wait') wait = true; return s === 'ok'; }); if (p) ok++; });
    k.ch.forEach(function (c) { dtTestsAt(k, 'chuong', c.id).forEach(function (t) { items++; var s = tPass(t, dtNeed(k, d.hb.kt)); if (s === 'wait') wait = true; if (s === 'ok') ok++; }); });
    var prog = items ? Math.round(ok / items * 100) : 0;
    var fin = dtTestsAt(k, 'khoa'), fs = fin.map(function (t) { var x = T[t.id]; if (!x || !x.ans) return null; return dtScoreT(t, x.ans, x.tl); });
    var fWait = fs.some(function (s) { return s && s.wait; }), fDone = fs.every(function (s) { return s && !s.wait; }), fPct = fs.filter(Boolean).length ? Math.round(fs.filter(Boolean).reduce(function (a, s) { return a + s.pct; }, 0) / fs.filter(Boolean).length * 10) / 10 : null;
    var fOk = !fin.length || (fDone && fs.every(function (s) { return s.pct >= dtNeed(k, d.hk.kt); }));
    var xnOk = !d.hk.xn.on || !!(r && r.xn);
    var st = !r ? 'chua' : r.tay ? 'dat' : (fWait || wait) ? 'cho' : (prog >= (+d.hk.pct || 0) && fOk && xnOk) ? 'dat' : (fDone && fin.length && !fOk) ? 'khong' : 'hoc';
    return { st: st, prog: r && r.tay ? 100 : prog, items: items, ok: ok, fPct: r && r.tay ? 100 : fPct, nDone: done.length, wait: fWait || wait };
  }
  function dtRow(u, e, k, R) {
    var id = e['Mã NV'], r = (dtOf(u).kq[id] || {})[k.id] || null, d = dtCd(k);
    var vao = e['Ngày vào làm'] || '', start = d.sc.moi ? vao : (vao && vao > d.giao ? vao : d.giao);
    var due = +d.han > 0 && start ? addDays(start, +d.han) : '', ev = dtEval(k, r), st = ev.st;
    if (st === 'dat' && +d.lap > 0 && r.xong && dtAddM(r.xong, +d.lap) <= R) { st = 'lai'; due = dtAddM(r.xong, +d.lap); }
    var late = st !== 'dat' && st !== 'cho' && due && due < R;
    return { u: u, e: e, id: id, k: k, r: r, ev: ev, st: st, due: due, start: start, late: !!late, days: due ? tdDiff(R, due) : null };
  }
  function dtRows(us, R, fk) {
    var out = [];
    us.forEach(function (u) {
      var mat = HR.maternitySet(u.data, R);
      (u.data.NV || []).forEach(function (e) {
        if (!e['Mã NV'] || HR.staffState(e, R, mat) === 'left') return;
        if (e['Ngày vào làm'] && e['Ngày vào làm'] > R) return;
        dtKh().forEach(function (k) { if (!dtCd(k).on || (fk && k.id !== fk)) return; if (dtApplies(k, u, e)) out.push(dtRow(u, e, k, R)); });
      });
    });
    return out;
  }

  /* ---------------- Trường liên kết dữ liệu có sẵn trên hệ thống ---------------- */
  var DT_F = [
    ['Người học', [['ho_ten', 'Họ và tên'], ['ma_nv', 'Mã nhân viên'], ['chuc_danh', 'Chức danh'], ['phong_ban', 'Phòng ban'], ['ngay_vao_lam', 'Ngày vào làm'], ['truong_bo_phan', 'Trưởng bộ phận'], ['phep_nam', 'Phép năm của người học']]],
    ['Công ty', [['cong_ty', 'Tên công ty'], ['dia_chi', 'Địa chỉ công ty'], ['giam_doc', 'Người đại diện'], ['so_nhan_su', 'Số nhân sự đang làm']]],
    ['Tổ chức, chế độ', [['so_do_to_chuc', 'Sơ đồ tổ chức (danh sách phòng ban)', 1], ['gio_lam_viec', 'Giờ làm việc của phòng ban'], ['ngay_nghi_le', 'Lịch nghỉ lễ năm nay', 1]]],
    ['Khóa học', [['ten_khoa', 'Tên khóa học'], ['giang_vien', 'Giảng viên'], ['thoi_luong', 'Thời lượng dự kiến']]]
  ];
  var DT_FL = {}, DT_FB = {}; DT_F.forEach(function (g) { g[1].forEach(function (f) { DT_FL[f[0]] = f[1]; if (f[2]) DT_FB[f[0]] = 1; }); });
  function dtCtx(k, u, e) {
    u = u || selUnits()[0] || S.units[0];
    if (!e && u) { var R = refDate(), mat = HR.maternitySet(u.data, R), L = (u.data.NV || []).filter(function (x) { return HR.staffState(x, R, mat) !== 'left'; }); e = L.filter(function (x) { return k && dtApplies(k, u, x); })[0] || L[0] || null; }
    return { k: k, u: u, e: e };
  }
  function dtVal(key, cx) {
    var u = cx.u, e = cx.e || {}, k = cx.k || {}, R = refDate();
    try {
      switch (key) {
        case 'ho_ten': return e['Họ và tên'] || ''; case 'ma_nv': return e['Mã NV'] || ''; case 'chuc_danh': return e['Chức danh công việc'] || ''; case 'phong_ban': return e['Phòng ban'] || '';
        case 'ngay_vao_lam': return e['Ngày vào làm'] ? vn(e['Ngày vào làm']) : '';
        case 'truong_bo_phan': { var pb = (u.data.PB || []).filter(function (p) { return p['Tên phòng ban'] === e['Phòng ban']; })[0], h = pb && pb['Mã NV trưởng bộ phận'] ? nvIndex(u)[pb['Mã NV trưởng bộ phận']] : null; return h ? h['Họ và tên'] + (h['Chức danh công việc'] ? ' (' + h['Chức danh công việc'] + ')' : '') : ''; }
        case 'phep_nam': { var q = npQuota(u, e, R); return q ? String(q.total).replace('.', ',') + ' ngày năm ' + R.slice(0, 4) + ', còn ' + String(q.left).replace('.', ',') + ' ngày' : ''; }
        case 'cong_ty': return coInfo(u).ten; case 'dia_chi': return coInfo(u).dc; case 'giam_doc': { var c = coInfo(u); return c.dd ? c.dd + (c.cv ? ' – ' + c.cv : '') : ''; }
        case 'so_nhan_su': { var mat = HR.maternitySet(u.data, R); return (u.data.NV || []).filter(function (x) { return HR.staffState(x, R, mat) !== 'left'; }).length + ' người'; }
        case 'gio_lam_viec': { var x = ccAppExtra(u).dept(e['Phòng ban'] || ''); if (!x || !x.ca) return ''; return x.ca.ten + ': ' + x.ca.vao + ' – ' + x.ca.ra + (x.tuan && x.tuan.length ? ', làm ' + x.tuan.map(function (d) { return DT_DOW[d]; }).join(', ') : ''); }
        case 'so_do_to_chuc': return dtOrg(u);
        case 'ngay_nghi_le': { var hs = holOf(ccOf(u), +R.slice(0, 4)); return hs.length ? '<ul>' + hs.map(function (h) { return '<li>' + esc(h.t || '') + (h.d ? ' – ' + vn(String(h.d).slice(0, 10)) : '') + '</li>'; }).join('') + '</ul>' : ''; }
        case 'ten_khoa': return k.ten || ''; case 'giang_vien': return k.gv || ''; case 'thoi_luong': return k.tl ? dtTlTxt(k) : '';
      }
    } catch (er) { return ''; }
    return '';
  }
  function dtOrg(u) {
    var nv = nvIndex(u), R = refDate(), mat = HR.maternitySet(u.data, R);
    var rows = (u.data.PB || []).map(function (p) {
      var h = p['Mã NV trưởng bộ phận'] ? nv[p['Mã NV trưởng bộ phận']] : null, n = (u.data.NV || []).filter(function (e) { return e['Phòng ban'] === p['Tên phòng ban'] && HR.staffState(e, R, mat) !== 'left'; }).length;
      return '<li><b>' + esc(p['Tên phòng ban']) + '</b>' + (h ? ' – phụ trách: ' + esc(h['Họ và tên']) : '') + ' · ' + n + ' người</li>';
    }).join('');
    return rows ? '<ul class="dt-org">' + rows + '</ul>' : '';
  }
  // HTML bài học → HTML hiển thị cho người học (thay trường bằng giá trị mới nhất, link chữ thành link bấm được)
  function dtRender(html, cx) {
    var box = document.createElement('div'); box.innerHTML = html || '';
    $$('[data-dtf]', box).forEach(function (s) {
      var key = s.getAttribute('data-dtf'), v = dtVal(key, cx);
      if (DT_FB[key]) { var w = document.createElement('div'); w.className = 'dt-fblk'; w.innerHTML = v || '<p class="faint">(chưa có dữ liệu ' + esc(DT_FL[key] || key) + ')</p>'; var p = s.parentNode; if (p && p.tagName === 'P' && p.textContent.trim() === s.textContent.trim()) p.parentNode.replaceChild(w, p); else s.parentNode.replaceChild(w, s); }
      else { var t = document.createElement('span'); t.className = 'dt-fv'; t.textContent = v || '(' + (DT_FL[key] || key) + ')'; s.parentNode.replaceChild(t, s); }
    });
    var walk = document.createTreeWalker(box, NodeFilter.SHOW_TEXT), tx = [], n; while ((n = walk.nextNode())) if (/https?:\/\//.test(n.nodeValue) && !(n.parentNode.closest && n.parentNode.closest('a'))) tx.push(n);
    tx.forEach(function (t) { var sp = document.createElement('span'); sp.innerHTML = esc(t.nodeValue).replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>'); t.parentNode.replaceChild(sp, t); });
    return box.innerHTML;
  }
  // nội dung soạn kiểu ký hiệu ở bản trước → HTML
  function dtMdHtml(t) {
    var out = [], list = null, inl = function (s) { return String(s).split('**').map(function (x, i) { var h = esc(x).replace(/\{\{\s*([a-z_]+)\s*\}\}/g, function (m, k) { return DT_FL[k] ? '<span data-dtf="' + k + '">' + esc(DT_FL[k]) + '</span>' : m; }); return i % 2 && h ? '<strong>' + h + '</strong>' : h; }).join(''); };
    function flush() { if (list) { out.push('<' + list.t + '>' + list.it.join('') + '</' + list.t + '>'); list = null; } }
    String(t || '').replace(/\r/g, '').split('\n').forEach(function (ln) {
      var s = ln.trim(), m;
      if ((m = /^[-*•]\s+(.*)$/.exec(s))) { if (!list || list.t !== 'ul') { flush(); list = { t: 'ul', it: [] }; } list.it.push('<li><p>' + inl(m[1]) + '</p></li>'); return; }
      if ((m = /^\d+[.)]\s+(.*)$/.exec(s))) { if (!list || list.t !== 'ol') { flush(); list = { t: 'ol', it: [] }; } list.it.push('<li><p>' + inl(m[1]) + '</p></li>'); return; }
      flush(); if (!s) return;
      if (/^##\s/.test(s)) out.push('<h3>' + inl(s.slice(3)) + '</h3>'); else if (/^#\s/.test(s)) out.push('<h2>' + inl(s.slice(2)) + '</h2>');
      else if (/^_.+_$/.test(s)) out.push('<p><em>' + inl(s.slice(1, -1)) + '</em></p>'); else out.push('<p>' + inl(s) + '</p>');
    });
    flush(); return out.join('');
  }
  function dtEmbed(url, api) {
    var s = String(url || '').trim(), m;
    if ((m = /(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/.exec(s))) return { kind: 'YouTube', src: 'https://www.youtube.com/embed/' + m[1] + (api ? '?enablejsapi=1&rel=0' : '?rel=0'), track: 1 };
    if ((m = /drive\.google\.com\/file\/d\/([\w-]+)/.exec(s)) || (m = /drive\.google\.com\/open\?id=([\w-]+)/.exec(s))) return { kind: 'Google Drive', src: 'https://drive.google.com/file/d/' + m[1] + '/preview' };
    if ((m = /vimeo\.com\/(?:video\/)?(\d+)/.exec(s))) return { kind: 'Vimeo', src: 'https://player.vimeo.com/video/' + m[1] + (api ? '?api=1' : ''), track: 2 };
    if (/^https?:\/\//.test(s)) return { kind: 'Link', src: '' };
    return null;
  }
  function dtEmbTxt(url, isVid) {
    var em = dtEmbed(url);
    if (!url) return isVid ? 'Chưa có link – dán link video, phần mềm tự nhận YouTube, Google Drive, Vimeo' : 'Chưa có link';
    if (!em) return '<span class="down">Link chưa đúng – cần bắt đầu bằng https://</span>';
    if (!isVid) return '<span class="ok">✓ Nhân viên bấm để mở tài liệu</span>';
    return em.src ? '<span class="ok">✓ Nhận ra ' + em.kind + ' – video hiện ngay trong bài' + (em.track ? ', tính được % đã xem' : ' (Google Drive không báo % đã xem – nhân viên bấm xác nhận)') + '</span>' : 'Không phải YouTube, Google Drive, Vimeo – nhân viên bấm mở trang video, rồi xác nhận đã xem';
  }

  /* ---------------- Khung soạn thảo (TipTap như Kho hợp đồng mẫu) + trường liên kết ---------------- */
  var DTX = null;
  function dtExt() {
    if (DTX) return DTX; var T = window.TT;
    var Fld = T.Node.create({
      name: 'dtField', group: 'inline', inline: true, atom: true, selectable: true, draggable: true,
      addAttributes: function () { return { k: { default: '', parseHTML: function (el) { return el.getAttribute('data-dtf'); }, renderHTML: function (a) { return { 'data-dtf': a.k }; } } }; },
      parseHTML: function () { return [{ tag: 'span[data-dtf]' }]; },
      renderHTML: function (p) { var k = p.node.attrs.k; return ['span', T.mergeAttributes(p.HTMLAttributes, { class: 'tpe-f dt-f' + (DT_FB[k] ? ' blk' : ''), title: 'Trường liên kết – bấm để xem giá trị mới nhất' }), (DT_FB[k] ? '▤ ' : '') + (DT_FL[k] || k)]; },
      renderText: function (p) { return '{{' + p.node.attrs.k + '}}'; }
    });
    DTX = { Fld: Fld }; return DTX;
  }
  function dtRteDestroy() { DT_ED.forEach(function (x) { try { x.ed.destroy(); } catch (e) { } }); DT_ED = []; dtPopClose(); }
  var DT_POP = null;
  function dtPopClose() { if (DT_POP) { DT_POP.remove(); DT_POP = null; document.removeEventListener('mousedown', dtPopOut, true); } }
  function dtPopOut(e) { if (DT_POP && !DT_POP.contains(e.target)) dtPopClose(); }
  function dtPopAt(el, html, cls) {
    dtPopClose(); var r = el.getBoundingClientRect(), p = document.createElement('div'); p.className = 'dt-pop ' + (cls || ''); p.innerHTML = html; document.body.appendChild(p);
    var w = p.offsetWidth, h = p.offsetHeight; p.style.left = Math.max(8, Math.min(r.left, window.innerWidth - w - 8)) + 'px'; p.style.top = (r.bottom + h + 8 > window.innerHeight ? Math.max(8, r.top - h - 6) : r.bottom + 6) + 'px';
    DT_POP = p; setTimeout(function () { document.addEventListener('mousedown', dtPopOut, true); }, 0); return p;
  }
  // Popup giá trị mới nhất của 1 trường (lấy với 1 người cụ thể – chọn được)
  function dtFieldPop(el, key, k) {
    var cx = dtCtx(k), us = S.units, opts = [];
    us.forEach(function (u) { var R = refDate(), mat = HR.maternitySet(u.data, R); (u.data.NV || []).forEach(function (x) { if (HR.staffState(x, R, mat) !== 'left') opts.push([u.id + '|' + x['Mã NV'], x['Họ và tên'] + (us.length > 1 ? ' · ' + shortUnit(u.name) : '')]); }); });
    function body() { var v = dtVal(key, cx); return '<div class="dt-pop-h"><b>' + esc(DT_FL[key] || key) + '</b><span class="faint">trường liên kết – luôn lấy dữ liệu mới nhất</span></div>' + (/^(ho_ten|ma_nv|chuc_danh|phong_ban|ngay_vao_lam|truong_bo_phan|phep_nam|gio_lam_viec)$/.test(key) ? '<label class="dt-pop-l">Xem với nhân sự <select class="input" id="dtFp">' + opts.map(function (o) { return '<option value="' + esc(o[0]) + '"' + (cx.e && o[0] === cx.u.id + '|' + cx.e['Mã NV'] ? ' selected' : '') + '>' + esc(o[1]) + '</option>'; }).join('') + '</select></label>' : '') + '<div class="dt-pop-v">' + (v ? (DT_FB[key] ? v : esc(v)) : '<span class="faint">(chưa có dữ liệu)</span>') + '</div><div class="dt-pop-f">' + dtFSrc(key) + '</div>'; }
    var p = dtPopAt(el, body(), 'fld');
    p.addEventListener('change', function (ev) { if (ev.target.id !== 'dtFp') return; var a = ev.target.value.split('|'), u = unitById(a[0]); cx = { k: k, u: u, e: nvIndex(u)[a[1]] }; p.innerHTML = body(); });
  }
  function dtFSrc(key) { var m = { phep_nam: 'Nghỉ phép → Quỹ phép', gio_lam_viec: 'Chấm công → Thiết lập chấm công', ngay_nghi_le: 'Chấm công → Thiết lập chung', so_do_to_chuc: 'Nhân sự → Sơ đồ tổ chức', truong_bo_phan: 'Cài đặt → Danh mục phòng ban', cong_ty: 'Hợp đồng → Thông tin công ty', dia_chi: 'Hợp đồng → Thông tin công ty', giam_doc: 'Hợp đồng → Thông tin công ty', ten_khoa: 'Thông tin khóa học', giang_vien: 'Thông tin khóa học', thoi_luong: 'Thông tin khóa học' }; return 'Nguồn: ' + (m[key] || 'Hồ sơ nhân sự'); }
  // Gắn khung soạn thảo vào 1 ô: host = phần tử, html ban đầu, onChange(html)
  function dtRte(host, html, onChange, k, ph) {
    if (!window.TT) { host.innerHTML = '<textarea class="input" rows="6">' + esc(html || '') + '</textarea>'; host.firstChild.addEventListener('input', function () { onChange(host.firstChild.value); }); return; }
    var T = window.TT, X = dtExt();
    var b = function (c, h, t) { return '<button type="button" class="tpe-b" data-c="' + c + '" title="' + t + '" aria-label="' + t + '">' + h + '</button>'; };
    host.innerHTML = '<div class="tpe-bar dt-tb">' +
      '<div class="tpe-g">' + b('undo', ic('undo', 16), 'Hoàn tác (Ctrl+Z)') + b('redo', ic('redo', 16), 'Làm lại (Ctrl+Y)') + '</div>' +
      '<div class="tpe-g"><select class="tpe-s" data-s="blk" title="Kiểu đoạn"><option value="p">Đoạn văn</option><option value="h2">Tiêu đề</option><option value="h3">Tiêu đề nhỏ</option></select></div>' +
      '<div class="tpe-g">' + b('b', '<b>B</b>', 'In đậm (Ctrl+B)') + b('i', '<i>I</i>', 'In nghiêng (Ctrl+I)') + b('u', '<u>U</u>', 'Gạch chân (Ctrl+U)') + '</div>' +
      '<div class="tpe-g">' + b('ul', ic('ul', 16), 'Gạch đầu dòng') + b('ol', ic('ol', 16), 'Đánh số') + b('al-left', ic('alL', 16), 'Căn trái') + b('al-center', ic('alC', 16), 'Căn giữa') + b('al-justify', ic('alJ', 16), 'Căn đều') + '</div>' +
      '<div class="tpe-g">' + b('tbl', ic('tbl', 16) + '<span>Bảng</span>', 'Chèn bảng, thêm hàng / cột') + '</div>' +
      '<div class="tpe-g">' + b('fld', ic('fld', 16) + '<span>Trường liên kết</span>', 'Chèn thông tin đã có trên hệ thống – luôn hiện dữ liệu mới nhất') + '</div></div>' +
      '<div class="dt-rte-doc"></div>';
    var ed = new T.Editor({
      element: host.querySelector('.dt-rte-doc'),
      extensions: [T.Document, T.Paragraph, T.Text, T.Bold, T.Italic, T.Underline, T.Heading.configure({ levels: [2, 3] }), T.HardBreak, T.BulletList, T.OrderedList, T.ListItem, T.ListKeymap, T.Dropcursor.configure({ color: '#3F6B35', width: 2 }), T.Gapcursor, T.UndoRedo,
        T.TextAlign.configure({ types: ['heading', 'paragraph'], alignments: ['left', 'center', 'justify'] }), T.Table.configure({ resizable: false }), T.TableRow, T.TableHeader, T.TableCell, X.Fld, T.Placeholder.configure({ placeholder: ph || 'Gõ nội dung…' })],
      content: html || '', editorProps: { attributes: { class: 'dt-rte-pm', spellcheck: 'false' } }
    });
    DT_ED.push({ ed: ed, host: host });
    function sync() {
      var set = function (c, on) { var x = host.querySelector('[data-c="' + c + '"]'); if (x) x.classList.toggle('on', !!on); };
      set('b', ed.isActive('bold')); set('i', ed.isActive('italic')); set('u', ed.isActive('underline')); set('ul', ed.isActive('bulletList')); set('ol', ed.isActive('orderedList'));
      var al = ed.getAttributes(ed.isActive('heading') ? 'heading' : 'paragraph').textAlign || 'left'; ['left', 'center', 'justify'].forEach(function (x) { set('al-' + x, al === x); });
      host.querySelector('[data-s="blk"]').value = ed.isActive('heading', { level: 2 }) ? 'h2' : ed.isActive('heading', { level: 3 }) ? 'h3' : 'p';
      host.querySelector('[data-c="undo"]').disabled = !ed.can().undo(); host.querySelector('[data-c="redo"]').disabled = !ed.can().redo();
    }
    ed.on('transaction', sync); ed.on('update', function () { onChange(ed.isEmpty ? '' : ed.getHTML()); }); sync();
    host.querySelector('[data-s="blk"]').addEventListener('change', function (e) { var v = e.target.value, c = ed.chain().focus(); (v === 'p' ? c.setParagraph() : c.setHeading({ level: +v.slice(1) })).run(); });
    host.querySelector('.dt-tb').addEventListener('mousedown', function (e) { if (e.target.closest('button')) e.preventDefault(); });
    host.querySelector('.dt-tb').addEventListener('click', function (e) {
      var x = e.target.closest('[data-c]'); if (!x) return; var c = x.getAttribute('data-c'), ch = ed.chain().focus();
      if (c === 'undo') ch.undo().run(); else if (c === 'redo') ch.redo().run(); else if (c === 'b') ch.toggleBold().run(); else if (c === 'i') ch.toggleItalic().run(); else if (c === 'u') ch.toggleUnderline().run();
      else if (c === 'ul') ch.toggleBulletList().run(); else if (c === 'ol') ch.toggleOrderedList().run(); else if (/^al-/.test(c)) ch.setTextAlign(c.slice(3)).run();
      else if (c === 'tbl') {
        var M = [['ins', 'Chèn bảng 3 × 3 có hàng tiêu đề'], ['addRowAfter', 'Thêm hàng phía dưới'], ['addColumnAfter', 'Thêm cột bên phải'], ['deleteRow', 'Xóa hàng'], ['deleteColumn', 'Xóa cột'], ['deleteTable', 'Xóa bảng']];
        var p = dtPopAt(x, '<div class="dt-pop-list">' + M.map(function (m) { return '<button type="button" data-t="' + m[0] + '">' + m[1] + '</button>'; }).join('') + '</div>', 'menu');
        p.addEventListener('mousedown', function (ev) { var t = ev.target.closest('[data-t]'); if (!t) return; ev.preventDefault(); var a = t.getAttribute('data-t'), cc = ed.chain().focus(); (a === 'ins' ? cc.insertTable({ rows: 3, cols: 3, withHeaderRow: true }) : cc[a]()).run(); dtPopClose(); });
      } else if (c === 'fld') {
        var p2 = dtPopAt(x, '<div class="dt-pop-h"><b>Trường liên kết</b><span class="faint">bấm để chèn tại con trỏ · trên bài học tự hiện dữ liệu mới nhất</span></div><div class="dt-pop-list">' + DT_F.map(function (g) { return '<div class="dt-pop-g">' + esc(g[0]) + '</div>' + g[1].map(function (f) { return '<button type="button" data-f="' + f[0] + '">' + (f[2] ? '▤ ' : '') + esc(f[1]) + '<small>' + esc(dtShort(dtVal(f[0], dtCtx(k)))) + '</small></button>'; }).join(''); }).join('') + '</div>', 'menu wide');
        p2.addEventListener('mousedown', function (ev) { var t = ev.target.closest('[data-f]'); if (!t) return; ev.preventDefault(); ed.chain().focus().insertContent({ type: 'dtField', attrs: { k: t.getAttribute('data-f') } }).insertContent(' ').run(); dtPopClose(); });
      }
    });
    host.querySelector('.dt-rte-doc').addEventListener('click', function (e) { var f = e.target.closest('[data-dtf]'); if (f) dtFieldPop(f, f.getAttribute('data-dtf'), k); });
    return ed;
  }
  function dtShort(v) { var t = String(v || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(); return t ? (t.length > 46 ? t.slice(0, 45) + '…' : t) : '(chưa có dữ liệu)'; }

  /* ---------------- Dữ liệu mẫu ---------------- */
  function dtQ(id, loai, hoi, pa, dung, diem, gy) { return loai === 'tl' ? { id: id, loai: 'tl', hoi: hoi, goi_y: gy || '', diem: diem || 2 } : { id: id, loai: loai, hoi: hoi, pa: pa, dung: dung, diem: diem || 1 }; }
  function dtSample(withSamples) {
    var F = function (k) { return '<span data-dtf="' + k + '">' + esc(DT_FL[k]) + '</span>'; };
    var hn = {
      id: 'KH01', mau: 1, ten: 'Hội nhập: Chào mừng bạn đến với công ty', tl: { n: 45, dv: 'phut' }, gv: 'Phòng Hành chính – Nhân sự', dt: 'Nhân viên mới trong 7 ngày đầu đi làm', bia: '', vid: '', mau_c: DT_COL[0],
      gt: '<p>Khóa tự học cho người mới: giới thiệu công ty, sơ đồ tổ chức, nội quy, chế độ và cách dùng app nhân viên. Học trên điện thoại, lúc nào rảnh cũng được.</p>',
      lt: ['Biết công ty làm gì, ai phụ trách bộ phận nào', 'Dùng thành thạo app: chấm công, gửi đơn, xem phiếu lương', 'Nắm nội quy và các chế độ lương, phép, bảo hiểm', 'Biết gặp vướng mắc thì hỏi ai'], hp: { loai: 'free', so: 0 },
      ch: [
        { id: 'c1', t: 'Chào mừng và giới thiệu công ty', mo: 'Công ty mình là ai, làm gì, gồm những bộ phận nào.', bai: [
          { id: 'b1', loai: 'doc', t: 'Thư chào mừng', ph: 5, html: '<h2>Chào mừng ' + F('ho_ten') + ' đến với ' + F('cong_ty') + '</h2><p>Cảm ơn bạn đã chọn đồng hành cùng chúng tôi. Khóa học này mất khoảng <strong>45 phút</strong>, bạn học trên điện thoại trong <strong>7 ngày đầu</strong> đi làm.</p><p>Bạn đang ở ' + F('phong_ban') + ', người phụ trách trực tiếp là ' + F('truong_bo_phan') + '.</p><p><em>Phòng nhân sự sửa nội dung này cho đúng với công ty mình ở Kho khóa học → Sửa.</em></p>' },
          { id: 'b2', loai: 'video', t: 'Video giới thiệu công ty', ph: 5, url: '', html: '<p>Dán link video giới thiệu công ty (YouTube, Google Drive…) – video hiện ngay trong bài.</p>' },
          { id: 'b3', loai: 'doc', t: 'Sơ đồ tổ chức – ai làm gì', ph: 5, html: '<h2>Các bộ phận trong công ty</h2><p>Danh sách dưới đây phần mềm tự lấy từ Sơ đồ tổ chức – luôn đúng với hiện tại:</p><p>' + F('so_do_to_chuc') + '</p><h3>Cần hỏi gì?</h3><ul><li><p>Việc chuyên môn: hỏi <strong>trưởng bộ phận</strong> hoặc <strong>người đồng hành</strong></p></li><li><p>Hồ sơ, hợp đồng, lương, bảo hiểm: hỏi <strong>phòng nhân sự</strong></p></li></ul>' }
        ] },
        { id: 'c2', t: 'Làm việc mỗi ngày', mo: 'Giờ làm, chấm công, nghỉ phép trên app.', bai: [
          { id: 'b4', loai: 'doc', t: 'Giờ làm việc, chấm công, nghỉ phép', ph: 10, html: '<h2>Giờ làm việc</h2><p>Giờ làm của bạn: ' + F('gio_lam_viec') + '.</p><h2>Chấm công trên app</h2><ul><li><p>Bấm <strong>Chấm công vào</strong> khi đến, <strong>Chấm công ra</strong> khi về (bắt Wi‑Fi công ty)</p></li><li><p>Quên chấm hoặc chấm sai: gửi <strong>Báo sai</strong> trên app trong ngày</p></li></ul><h2>Nghỉ phép</h2><p>Phép năm của bạn: ' + F('phep_nam') + '. Xin nghỉ bằng mục <strong>Đơn</strong> trên app, gửi trước ít nhất 1 ngày.</p><h3>Các ngày nghỉ lễ năm nay</h3><p>' + F('ngay_nghi_le') + '</p>' }
        ] },
        { id: 'c3', t: 'Nội quy và chế độ', mo: 'Những điểm chính của nội quy, lương, phép, bảo hiểm.', bai: [
          { id: 'b5', loai: 'doc', t: 'Nội quy lao động – những điểm chính', ph: 10, html: '<ol><li><p>Đi làm đúng giờ; đi muộn, về sớm phải báo trưởng bộ phận</p></li><li><p>Giữ bí mật thông tin khách hàng, học viên, dữ liệu của công ty</p></li><li><p>Ứng xử lịch sự với đồng nghiệp, khách hàng</p></li><li><p>Giữ gìn tài sản, thiết bị được giao</p></li></ol><p>Bản nội quy đầy đủ ở bài Tài liệu tiếp theo.</p>' },
          { id: 'b6', loai: 'link', t: 'Nội quy lao động (bản đầy đủ)', ph: 5, url: '', html: '<p>Dán link file nội quy lao động (Google Drive, OneDrive…).</p>' },
          { id: 'b7', loai: 'doc', t: 'Lương, phép, bảo hiểm', ph: 5, html: '<h2>Lương</h2><ul><li><p>Lương trả hằng tháng; phiếu lương xem trên app ở mục <strong>Lương</strong></p></li><li><p>Thắc mắc phiếu lương: hỏi phòng nhân sự trong 3 ngày sau khi nhận</p></li></ul><h2>Bảo hiểm</h2><p>Công ty đăng ký bảo hiểm xã hội, y tế, thất nghiệp khi bạn ký hợp đồng lao động theo quy định.</p>' }
