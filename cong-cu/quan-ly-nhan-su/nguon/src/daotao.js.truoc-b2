      '.dt-nav{display:flex;flex-direction:column;gap:2px;border-right:1px solid var(--line);padding-right:12px;max-height:70vh;overflow:auto}.dt-nch{font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);padding:10px 8px 2px}',
      '.dt-ni{display:flex;gap:8px;align-items:center;text-align:left;border:0;background:none;border-radius:9px;padding:6px 8px;font:inherit;font-size:13px;color:var(--ink-2);cursor:pointer}.dt-ni.in{padding-left:16px}.dt-ni:hover{background:var(--surface-2)}.dt-ni.on{background:var(--pri-soft);color:var(--pri-ink);font-weight:600}.dt-ni.ok svg{color:var(--ok,#2E7D32)}.dt-ni svg{flex:none}',
      '.dt-nprog{margin-top:auto;padding-top:10px;display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted)}',
      '.dt-view{min-width:0;max-height:70vh;overflow:auto;padding-right:4px}.dt-vh small{color:var(--muted);font-size:12px}.dt-vh h3{margin:2px 0 12px;font-size:19px}',
      '.dt-pcov{height:180px;border-radius:14px;background-size:cover;background-position:center;margin-bottom:12px}.dt-pcov.c{background:linear-gradient(135deg,var(--dc),color-mix(in srgb,var(--dc) 45%,#fff));display:flex;align-items:flex-end;padding:16px;color:#fff;font-size:20px}',
      '.dt-meta{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:13px;color:var(--ink-2);margin-bottom:12px}.dt-meta span{display:inline-flex;gap:5px;align-items:center}.dt-meta svg{color:var(--pri)}',
      '.dt-h4{margin:14px 0 6px;font-size:15px}.dt-ben{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:6px}.dt-ben li{display:flex;gap:8px;align-items:flex-start;font-size:13.5px}.dt-ben svg{color:var(--pri);flex:none;margin-top:2px}',
      '.dt-howto{display:flex;gap:8px;align-items:flex-start;background:var(--surface-2);border-radius:10px;padding:10px 12px;margin-top:14px;font-size:13px}',
      '.dt-md{font-size:14.5px;line-height:1.65;color:var(--ink)}.dt-md h2{font-size:18px;margin:14px 0 6px}.dt-md h3{font-size:15.5px;margin:12px 0 4px}.dt-md p{margin:6px 0}.dt-md ul,.dt-md ol{margin:6px 0;padding-left:22px}.dt-md li p{margin:2px 0}.dt-md a{color:var(--pri-ink)}.dt-md table{border-collapse:collapse;width:100%;margin:8px 0}.dt-md td,.dt-md th{border:1px solid var(--line-2);padding:5px 8px}.dt-md th{background:var(--surface-2)}',
      '.dt-fv{font-weight:600}.dt-fblk{margin:6px 0}.dt-org{list-style:none;padding:0!important;display:flex;flex-direction:column;gap:4px}.dt-org li{background:var(--surface-2);border-radius:8px;padding:6px 10px}',
      '.dt-vid{position:relative;padding-top:56.25%;border-radius:12px;overflow:hidden;background:#000;margin-bottom:10px}.dt-vid iframe{position:absolute;inset:0;width:100%;height:100%;border:0}.dt-vid.sm{margin-top:8px}',
      '.dt-vp{display:flex;flex-direction:column;gap:4px;font-size:12px;color:var(--muted);margin-bottom:10px}',
      '.dt-ph{display:flex;flex-direction:column;align-items:center;gap:6px;padding:34px 16px;border:2px dashed var(--line-2);border-radius:12px;color:var(--muted);margin-bottom:10px}.dt-ph b{color:var(--ink-2)}',
      '.dt-lnk{display:flex;gap:12px;align-items:center;border:1px solid var(--line-2);border-radius:12px;padding:12px 14px;text-decoration:none;color:var(--ink);margin-bottom:10px}.dt-lnk:hover{border-color:var(--pri);background:var(--pri-soft)}.dt-lnk span{display:flex;flex-direction:column;flex:1;min-width:0}.dt-lnk small{color:var(--muted)}.dt-lnk em{font-style:normal;color:var(--pri-ink);font-weight:600}',
      '.dt-vf{display:flex;justify-content:space-between;gap:8px;margin-top:16px;padding-top:12px;border-top:1px solid var(--line)}.dt-vfr{display:flex;gap:8px}',
      '.dt-timer{position:sticky;top:0;z-index:2;margin-left:auto;width:max-content;background:#FFF1D6;color:#7A4E05;border-radius:99px;padding:4px 12px;font-weight:700;font-variant-numeric:tabular-nums;margin-bottom:8px}',
      '.dt-qz{display:flex;flex-direction:column;gap:14px}.dt-qi{border:1px solid var(--line);border-radius:12px;padding:12px 14px;display:flex;flex-direction:column;gap:6px}.dt-qh{font-size:14px;line-height:1.5}',
      '.dt-opt{display:flex;gap:8px;align-items:flex-start;padding:7px 10px;border-radius:9px;cursor:pointer;border:1px solid transparent}.dt-opt:hover{background:var(--surface-2)}.dt-opt:has(input:checked){background:var(--pri-soft);border-color:var(--pri-soft-2)}.dt-opt input{margin-top:3px}',
      '.dt-score{display:flex;gap:14px;align-items:center;border-radius:14px;padding:14px 16px;margin-bottom:12px;background:var(--surface-2)}.dt-score b{font-size:28px}.dt-score.ok{background:var(--pri-soft);color:var(--pri-ink)}.dt-score.bad{background:#FDE8E6;color:#8C1D18}.dt-score.wait{background:#FFF1D6;color:#7A4E05}',
      '.dt-rv{display:flex;flex-direction:column;gap:8px}.dt-rvi{border:1px solid var(--line);border-radius:10px;padding:9px 12px;font-size:13.5px}.dt-rvi.ok{border-left:4px solid var(--ok,#2E7D32)}.dt-rvi.bad{border-left:4px solid var(--danger)}.dt-rvi ul{margin:6px 0 0;padding-left:18px}.dt-rvi li.cr{color:var(--ok,#2E7D32);font-weight:600}.dt-rvi li.my:not(.cr){color:var(--danger)}.dt-rvi em{font-style:normal;font-size:12px}.dt-rvi small{display:block;margin-top:4px}.dt-rvi small.ok{color:var(--ok,#2E7D32)}.dt-rvi small.warn{color:#9A6200}',
      '.dt-rva{background:var(--surface-2);border-radius:8px;padding:8px 10px;margin-top:6px;white-space:pre-wrap;font-size:13.5px}',
      '.dt-xn{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--line-2);border-radius:12px;padding:14px;font-size:14.5px;cursor:pointer}.dt-xn input{margin-top:4px;transform:scale(1.2)}',
      '.dt-end{display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px;padding:30px 10px}.dt-end svg{color:var(--pri)}.dt-end h3{margin:4px 0 0}.dt-cond{list-style:none;padding:0;margin:6px 0;text-align:left;display:flex;flex-direction:column;gap:6px}.dt-cond li{padding-left:24px;position:relative;font-size:14px;color:var(--muted)}.dt-cond li::before{content:"○";position:absolute;left:4px}.dt-cond li.ok{color:var(--ink)}.dt-cond li.ok::before{content:"✓";color:var(--ok,#2E7D32);font-weight:700}',
      '.dt-cham{border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:10px;display:flex;flex-direction:column;gap:8px}.dt-cham .field{margin:0}.dt-gy{background:#FFF8EA;border-radius:8px;padding:8px 10px;font-size:13px;color:#6B4A0F}.dt-chsum{margin:6px 0 12px;font-size:14px}.dt-chT h4{margin:4px 0 6px}',
      '.dt-k{grid-template-columns:repeat(7,minmax(0,1fr))}@media (max-width:1200px){.dt-k{grid-template-columns:repeat(4,minmax(0,1fr))}}@media (max-width:640px){.dt-k{grid-template-columns:repeat(2,minmax(0,1fr))}}.dt-k .anv-t{min-width:0}',
      '.dt-g .c{text-align:center}.dt-dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:6px;vertical-align:1px}tr.dt-late td:first-child{box-shadow:inset 3px 0 0 var(--danger)}.dt-mini{display:flex;flex-direction:column;gap:3px;margin-top:5px;font-size:11.5px;color:var(--muted)}.dt-mini .dt-bar{height:4px}',
      '.dt-cell{border:0;border-radius:99px;padding:3px 10px;font:inherit;font-size:12px;font-weight:600;cursor:pointer;background:var(--surface-2);color:var(--muted)}.dt-cell.st-dat{background:var(--pri-soft);color:var(--pri-ink)}.dt-cell.st-hoc{background:#E3EEF9;color:#1F5F8B}.dt-cell.st-cho,.dt-cell.st-lai{background:#FFF1D6;color:#7A4E05}.dt-cell.st-khong{background:#FDE8E6;color:#8C1D18}.dt-cell.dt-lt{box-shadow:inset 0 0 0 1.5px var(--danger)}',
      '@media (max-width:1100px){.dt-ed,.dt-bg,.dt-cdg{grid-template-columns:1fr}.dt-bgl{position:static;max-height:none}.dt-2b{grid-template-columns:1fr 1fr}}',
      '@media (max-width:760px){.dt-pl{grid-template-columns:1fr}.dt-nav{flex-direction:row;overflow:auto;border-right:0;border-bottom:1px solid var(--line);padding:0 0 8px;max-height:none}.dt-nch{display:none}.dt-ni{white-space:nowrap}.dt-nprog{display:none}.dt-view{max-height:none}.dt-2,.dt-3,.dt-2b,.dt-ben{grid-template-columns:1fr}.dt-rule{grid-template-columns:22px 1fr}.dt-rule>*:nth-child(n+3){grid-column:1/-1}.dt-edt span{max-width:200px}}'
    ].join('\n');
    var st = document.createElement('style'); st.id = 'dt-css'; st.textContent = css; document.head.appendChild(st);
  })();
