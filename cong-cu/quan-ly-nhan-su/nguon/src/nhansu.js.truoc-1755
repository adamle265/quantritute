        }).join('') + '</tbody><tfoot><tr><td>Số người còn thiếu</td>' + cnt.map(function (n) { return '<td class="c' + (n ? ' bad' : '') + '">' + (n || '–') + '</td>'; }).join('') + '<td></td><td></td></tr></tfoot></table></div></div>';
