        { id: 'b2', loai: 'link', t: 'Bộ câu hỏi thường gặp', ph: 15, url: '', html: '' }] }],
      tests: [{ id: 't1', ten: 'Tình huống tư vấn', gan: { l: 'khoa', id: '' }, tg: 0, cau: [dtQ('q1', 'mot', 'Bước nào nên làm trước khi giới thiệu khóa học?', ['Báo học phí', 'Hỏi mục tiêu học của học viên', 'Gửi tất cả tài liệu'], [1]), dtQ('q2', 'tl', 'Học viên nói "học phí cao quá". Bạn trả lời thế nào?', null, null, 3, 'Ghi nhận băn khoăn, hỏi lại mục tiêu, nêu giá trị khóa học, giới thiệu ưu đãi nếu có – không hạ giá tùy tiện.')] }],
      cd: { on: true, bb: false, sc: { us: [], pb: ['Phòng Tuyển sinh'], cd: [], moi: false }, han: 30, lap: 0, giao: '2026-10-01', thang: 10, hb: { doc: 'xn', link: 'mo', vid: 80, kt: 5 }, hk: { pct: 100, kt: 6, xn: { on: false, nd: '' } } }
