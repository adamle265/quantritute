      '.dt-tabs{display:flex;gap:2px;margin-top:10px;overflow:auto}.dt-tab{display:inline-flex;align-items:center;gap:8px;border:0;background:none;padding:10px 14px 11px;font:inherit;font-size:14px;font-weight:600;color:var(--muted);cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap}.dt-tab:hover{color:var(--ink)}.dt-tab.on{color:var(--pri-ink);border-bottom-color:var(--pri)}',
