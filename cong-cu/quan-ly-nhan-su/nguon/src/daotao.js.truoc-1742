  // Kết quả mẫu: người đã hoàn thành, đang học, chờ chấm, chưa đạt
  function dtSeedKq(u) {
    var R = refDate(), kq = u.dt.kq, mat = HR.maternitySet(u.data, R), ppl = (u.data.NV || []).filter(function (e) { return e['Mã NV'] && HR.staffState(e, R, mat) !== 'left'; });
    ppl.forEach(function (e, i) {
      var id = e['Mã NV'];
      dtKh().forEach(function (k) {
        if (!dtApplies(k, u, e)) return;
        var pick = (i * 7 + k.id.charCodeAt(3)) % 6, d0 = addDays(R, -(2 + (i % 8))), L = dtLessons(k);
        if (k.id === 'KH01') pick = [4, 2, 1, 4][i % 4];
        if (pick === 0) return;
        var r = { bd: addDays(d0, -2), bai: [], tests: {} };
        if (pick === 1) { r.bai = L.slice(0, 1 + (i % L.length)).map(function (l) { return l.b.id; }); (kq[id] = kq[id] || {})[k.id] = r; return; }
        r.bai = L.map(function (l) { return l.b.id; }); r.xong = d0; if (k.cd.hk.xn.on) r.xn = d0;
        k.tests.forEach(function (t, ti) {
          var ans = {}, tl = {};
          t.cau.forEach(function (q, qi) { if (q.loai === 'tl') { ans[q.id] = 'Em sẽ không gửi thông tin ra ngoài và khóa máy khi rời chỗ, vì lộ thông tin làm mất uy tín công ty và ảnh hưởng tới khách hàng.'; if (pick !== 2) tl[q.id] = { d: (+q.diem || 1) - (qi % 2 ? 0.5 : 0), nx: 'Ý đúng, nêu được việc cụ thể.' }; } else ans[q.id] = (i + qi + ti) % 7 === 0 ? [((q.dung || [0])[0] + 1) % q.pa.length] : (q.dung || []).slice(); });
          var s = dtScoreT(t, ans, tl); r.tests[t.id] = { ans: ans, tl: tl, pct: s.pct, lan: 1, at: d0 };
        });
        (kq[id] = kq[id] || {})[k.id] = r;
      });
    });
  }

  /* ---------------- Trang Kho khóa học ---------------- */
  PAGES.dtkhoa = function () {
    dtRteDestroy();
    var f = ps('dt', { ed: null });
    if (f.ed) return dtEditor(f.ed);
    var L = dtKh(), R = refDate(), all = dtRows(selUnits(), R);
    var by = {}; all.forEach(function (x) { var b = by[x.k.id] = by[x.k.id] || { n: 0, dat: 0, late: 0, cho: 0 }; b.n++; if (x.st === 'dat') b.dat++; if (x.late) b.late++; if (x.st === 'cho') b.cho++; });
    var on = L.filter(function (k) { return k.cd.on; }), nDat = all.filter(function (x) { return x.st === 'dat'; }).length;
    var kpi = '<div class="org-kpi"><div><b>' + on.length + '</b><span>khóa đang mở</span></div><div><b>' + on.filter(function (k) { return k.cd.bb; }).length + '</b><span>khóa bắt buộc</span></div><div><b>' + all.length + '</b><span>lượt cần học</span></div><div><b>' + (all.length ? Math.round(nDat / all.length * 100) : 0) + '%</b><span>đã hoàn thành</span></div>' +
      '<div class="' + (all.some(function (x) { return x.late; }) ? 'k-bad' : '') + '"><b>' + all.filter(function (x) { return x.late; }).length + '</b><span>lượt quá hạn</span></div><div class="' + (all.some(function (x) { return x.st === 'cho'; }) ? 'k-warn' : '') + '"><b>' + all.filter(function (x) { return x.st === 'cho'; }).length + '</b><span>bài chờ chấm</span></div></div>';
    var cards = L.map(function (k) {
      var b = by[k.id] || { n: 0, dat: 0, late: 0, cho: 0 }, pct = b.n ? Math.round(b.dat / b.n * 100) : 0, nb = dtNb(k), nv = dtLessons(k).filter(function (x) { return x.b.loai === 'video'; }).length, d = k.cd;
      return '<div class="dt-card' + (d.on ? '' : ' off') + '" style="--dc:' + (k.mau_c || DT_COL[0]) + '">' + (k.bia ? '<div class="dt-cimg" style="background-image:url(\'' + esc(k.bia) + '\')"></div>' : '<div class="dt-cbar"></div>') + '<div class="dt-cb">' +
        '<div class="dt-ctags">' + (d.on ? '' : '<span class="tag tag-mute">Đang tắt</span>') + (d.bb ? '<span class="tag tag-warn">Bắt buộc</span>' : '<span class="tag tag-mute">Tự chọn</span>') + (d.sc.moi ? '<span class="tag tag-info">Người mới</span>' : '') + (+d.lap ? '<span class="tag tag-info">Học lại ' + d.lap + ' tháng</span>' : '') + (k.hp.loai === 'phi' ? '<span class="tag tag-info">' + fmtInt(+k.hp.so || 0) + ' đ</span>' : '') + '</div>' +
        '<h3>' + esc(k.ten) + '</h3><p class="dt-cmo">' + esc(dtSum(k)) + '</p>' +
        '<div class="dt-cmeta"><span>' + ic('dt_ch', 14) + k.ch.length + ' chương · ' + nb + ' bài' + (nv ? ' · ' + nv + ' video' : '') + '</span><span>' + ic('dt_quiz', 14) + (k.tests.length ? k.tests.length + ' bài kiểm tra' : 'Không có bài kiểm tra') + '</span>' + (dtTlTxt(k) ? '<span>' + ic('hn_clock', 14) + dtTlTxt(k) + '</span>' : '') + (k.gv ? '<span>' + ic('dt_user', 14) + esc(k.gv) + '</span>' : '') + '</div>' +
        '<div class="dt-cfor">Áp dụng: <b>' + esc(dtScText(k)) + '</b>' + (+d.han ? ' · hạn ' + d.han + ' ngày' : '') + '</div>' +
        '<button class="dt-cprog" data-act="dt-res" data-id="' + k.id + '" title="Xem ai đã học, ai chưa"><span class="dt-bar"><i style="width:' + pct + '%"></i></span><span><b>' + b.dat + '/' + b.n + '</b> người hoàn thành' + (b.late ? ' · <em class="down">' + b.late + ' quá hạn</em>' : '') + (b.cho ? ' · <em class="warn">' + b.cho + ' chờ chấm</em>' : '') + '</span></button>' +
        '<div class="dt-cact"><button class="btn btn-sm" data-act="dt-view" data-id="' + k.id + '">' + ic('dt_play', 14) + 'Xem thử</button><button class="btn btn-sm btn-primary" data-act="dt-edit" data-id="' + k.id + '">Sửa</button><span class="sp"></span>' +
        '<button class="btn btn-sm dt-ib" data-act="dt-dup" data-id="' + k.id + '" title="Nhân bản khóa học" aria-label="Nhân bản">' + ic('td_copy', 15) + '</button><button class="btn btn-sm dt-ib" data-act="dt-onoff" data-id="' + k.id + '" title="' + (d.on ? 'Tắt khóa học (giữ kết quả, không giao thêm)' : 'Mở lại khóa học') + '" aria-label="' + (d.on ? 'Tắt' : 'Mở') + '">' + ic(d.on ? 'dt_pause' : 'dt_play', 15) + '</button><button class="btn btn-sm dt-ib dt-del" data-act="dt-del" data-id="' + k.id + '" title="Xóa khóa học" aria-label="Xóa">' + ic('td_trash', 15) + '</button></div></div></div>';
    }).join('');
    return pageHead('Kho khóa học', 'Khóa học nội bộ chia theo chương, bài: bài đọc, tài liệu, video (dán link), bài kiểm tra. Nhân viên học trên app; phần mềm theo dõi ai đã học, ai còn phải học.', '<button class="btn btn-primary" data-act="dt-new">' + ic('td_plus', 15) + 'Tạo khóa học</button>') +
      kpi + '<div class="dt-grid">' + cards + '<button class="dt-card dt-add" data-act="dt-new"><span>' + ic('td_plus', 26) + '</span><b>Tạo khóa học mới</b><small>Bắt đầu từ trang trống hoặc nhân bản một khóa có sẵn</small></button></div>' +
      '<div class="notice" style="margin-top:14px">' + ic('info') + '<div><b>Bản thử:</b> nhân viên học và làm bài trên app sẽ có ở bước tiếp theo – hiện tại bấm <b>Xem thử</b> để học và làm bài như nhân viên; kết quả mẫu ở trang <b>Theo dõi học tập</b> là dữ liệu hư cấu.</div></div>';
  };
  BINDS.dtkhoa = function () { if (PS.dt && PS.dt.ed) dtBindEditor(); };
  function dtBlank() { return dtNorm({ id: dtId('KH'), ten: '', tl: { n: 0, dv: 'phut' }, gv: '', dt: '', bia: '', vid: '', gt: '', lt: [], hp: { loai: 'free', so: 0 }, mau_c: DT_COL[dtKh().length % DT_COL.length], ch: [{ id: dtId('c'), t: 'Chương 1', mo: '', bai: [] }], tests: [], cd: {} }); }
  function dtOpen(k, isNew, dirty) { PS.dt.ed = { k: k, isNew: isNew, dirty: !!dirty, tab: 'info', sel: { c: 0, b: k.ch[0] && k.ch[0].bai.length ? 0 : -1 }, ts: 0 }; render(); window.scrollTo(0, 0); }
  ACTS['dt-new'] = function () { dtOpen(dtBlank(), true); };
  ACTS['dt-edit'] = function (a, id) { var k = dtById(id); if (k) dtOpen(JSON.parse(JSON.stringify(k)), false); };
  ACTS['dt-dup'] = function (a, id) { var k = dtById(id); if (!k) return; var c = JSON.parse(JSON.stringify(k)); c.id = dtId('KH'); c.ten = k.ten + ' (bản sao)'; delete c.mau; c.cd.giao = HR.isoToday(); dtOpen(c, true, true); toast('Đã tạo bản sao – sửa rồi bấm Lưu khóa học', 'info'); };
  ACTS['dt-onoff'] = function (a, id) { var k = dtById(id); if (!k) return; k.cd.on = !k.cd.on; dtSave((k.cd.on ? 'Mở' : 'Tắt') + ' khóa ' + k.ten); render(); };
  ACTS['dt-del'] = function (a, id) {
    var k = dtById(id); if (!k) return; var n = 0; S.units.forEach(function (u) { if (u.dt) Object.keys(u.dt.kq || {}).forEach(function (m) { if (u.dt.kq[m][id]) n++; }); });
    confirmBox('Xóa khóa "' + k.ten + '"?', (n ? 'Khóa đã có ' + n + ' lượt học – kết quả học của khóa này cũng bị xóa. ' : '') + 'Muốn giữ kết quả thì bấm Tắt thay vì Xóa.', 'Xóa khóa học', function () {
      S.settings.dtKh = dtKh().filter(function (x) { return x.id !== id; }); S.units.forEach(function (u) { if (u.dt) Object.keys(u.dt.kq || {}).forEach(function (m) { delete u.dt.kq[m][id]; }); });
      dtSave('Xóa khóa ' + k.ten); toast('Đã xóa khóa học', 'ok'); render();
    });
  };
  ACTS['dt-res'] = function (a, id) { ps('dtk', { co: '', pb: '', kh: '', st: '', q: '', view: 'list' }).kh = id; go('dtketqua'); };

  /* ---------------- Trình soạn khóa học: 4 tab ---------------- */
  var DT_TABS = [['info', 'Thông tin khóa học'], ['bg', 'Bài giảng'], ['kt', 'Bài kiểm tra'], ['cd', 'Cài đặt']];
  function dtOpts(list, sel) { return list.map(function (o) { return '<option value="' + esc(o[0]) + '"' + (String(o[0]) === String(sel) ? ' selected' : '') + '>' + esc(o[1]) + '</option>'; }).join(''); }
  function dtAllPb() { var o = {}; S.units.forEach(function (u) { (u.data.PB || []).forEach(function (p) { if (p['Tên phòng ban']) o[p['Tên phòng ban']] = 1; }); }); return Object.keys(o).sort(); }
  function dtAllCd(pbs) { var o = {}; S.units.forEach(function (u) { (u.data.NV || []).forEach(function (e) { if (e['Chức danh công việc'] && (!pbs || !pbs.length || pbs.indexOf(e['Phòng ban']) >= 0)) o[e['Chức danh công việc']] = 1; }); }); return Object.keys(o).sort(); }
  function dtChips(name, all, sel) { return '<div class="dt-chips">' + all.map(function (v) { return '<label class="dt-chip' + (sel.indexOf(v) >= 0 ? ' on' : '') + '"><input type="checkbox" data-sc="' + name + '" value="' + esc(v) + '"' + (sel.indexOf(v) >= 0 ? ' checked' : '') + '>' + esc(v) + '</label>'; }).join('') + '</div>'; }
  function dtErrs(k) {
    var E = { info: [], bg: [], kt: [], cd: [] };
    if (!String(k.ten || '').trim()) E.info.push('Chưa có tên khóa học');
    if (k.hp.loai === 'phi' && !(+k.hp.so > 0)) E.info.push('Chọn Trả phí nhưng chưa nhập học phí');
    if (k.vid && !/^https?:\/\//.test(k.vid)) E.info.push('Link video giới thiệu cần bắt đầu bằng https://');
    if (!k.ch.length) E.bg.push('Khóa học cần ít nhất 1 chương');
    if (!dtNb(k)) E.bg.push('Khóa học chưa có bài học nào');
    k.ch.forEach(function (c, ci) { if (!String(c.t || '').trim()) E.bg.push('Chương ' + (ci + 1) + ' chưa có tên'); c.bai.forEach(function (b, bi) { var n = 'Bài ' + (ci + 1) + '.' + (bi + 1); if (!String(b.t || '').trim()) E.bg.push(n + ' chưa có tên'); if (b.loai === 'doc' && !String(b.html || '').replace(/<[^>]+>/g, '').trim() && !/data-dtf/.test(b.html || '')) E.bg.push(n + ' chưa có nội dung'); if (b.loai !== 'doc' && b.url && !/^https?:\/\//.test(b.url)) E.bg.push(n + ': link cần bắt đầu bằng https://'); }); });
    k.tests.forEach(function (t, ti) {
      var n = 'Bài kiểm tra ' + (ti + 1); if (!String(t.ten || '').trim()) E.kt.push(n + ' chưa có tên'); if (!t.cau.length) E.kt.push(n + ' chưa có câu hỏi'); if (/^Chưa gắn/.test(dtGanTxt(k, t))) E.kt.push(n + ' chưa gắn vào đâu');
      t.cau.forEach(function (q, qi) { var m = n + ', câu ' + (qi + 1); if (!String(q.hoi || '').trim()) E.kt.push(m + ' chưa có nội dung'); if (q.loai !== 'tl') { if ((q.pa || []).filter(function (p) { return String(p).trim(); }).length < 2) E.kt.push(m + ' cần ít nhất 2 phương án'); if ((q.pa || []).some(function (p) { return !String(p).trim(); })) E.kt.push(m + ' có phương án để trống'); if (!(q.dung || []).length) E.kt.push(m + ' chưa đánh dấu đáp án đúng'); } });
    });
    var d = k.cd; if (d.hk.xn.on && !String(d.hk.xn.nd || '').trim()) E.cd.push('Chưa có nội dung xác nhận cuối khóa');
    if (+d.hk.kt > d.thang || +d.hb.kt > d.thang) E.cd.push('Điểm đạt lớn hơn thang điểm ' + d.thang);
    return E;
  }
  function dtEditor(ed) {
    var k = ed.k, E = dtErrs(k);
    var tabs = '<div class="dt-tabs" role="tablist">' + DT_TABS.map(function (t, i) { var n = t[0] === 'bg' ? dtNb(k) : t[0] === 'kt' ? k.tests.length : null; return '<button role="tab" class="dt-tab' + (ed.tab === t[0] ? ' on' : '') + '" data-act="dt-tab" data-id="' + t[0] + '" aria-selected="' + (ed.tab === t[0]) + '"><span class="dt-tn">' + (i + 1) + '</span>' + t[1] + (n !== null ? ' <em>' + n + '</em>' : '') + (E[t[0]].length ? '<i class="dt-terr" title="' + esc(E[t[0]].join(' · ')) + '">' + E[t[0]].length + '</i>' : '') + '</button>'; }).join('') + '</div>';
    var head = '<div class="dt-edh"><button class="btn hn-back" data-act="dt-cancel">' + ic('hn_back', 16) + 'Kho khóa học</button><div class="dt-edt"><b>' + (ed.isNew ? 'Tạo khóa học' : 'Sửa khóa học') + '</b><span>' + esc(k.ten || 'Chưa đặt tên') + '</span></div><span class="sp"></span><span class="faint dt-dirty">' + (ed.dirty ? 'Có thay đổi chưa lưu' : '') + '</span><button class="btn" data-act="dt-prev">' + ic('dt_play', 15) + 'Xem thử</button><button class="btn btn-primary" data-act="dt-save">Lưu khóa học</button></div>';
    var body = ed.tab === 'bg' ? dtTabBg(ed) : ed.tab === 'kt' ? dtTabKt(ed) : ed.tab === 'cd' ? dtTabCd(ed) : dtTabInfo(ed);
    return '<div class="dt-edwrap">' + head + tabs + '</div>' + body;
  }
  // Tab 1: Thông tin khóa học
  function dtTabInfo(ed) {
    var k = ed.k, staff = []; S.units.forEach(function (u) { (u.data.NV || []).forEach(function (e) { if (e['Họ và tên']) staff.push(e['Họ và tên'] + (e['Chức danh công việc'] ? ' – ' + e['Chức danh công việc'] : '')); }); });
    var em = k.vid ? dtEmbed(k.vid) : null;
    return '<div class="dt-ed"><div class="dt-main">' +
      '<div class="card card-pad"><h3 class="dt-sh">Thông tin chung</h3>' +
      '<div class="field"><label>Tên khóa học <i class="req">*</i></label><input class="input dt-big" data-kf="ten" value="' + esc(k.ten) + '" placeholder="Ví dụ: Hội nhập cho nhân viên mới" maxlength="120"></div>' +
      '<div class="dt-3"><div class="field"><label>Thời lượng dự kiến</label><span class="dt-in"><input class="input num" type="number" min="0" step="1" data-kf="tl.n" value="' + (+k.tl.n || '') + '" placeholder="0"><select class="input" data-kf="tl.dv">' + dtOpts(DT_TLD, k.tl.dv) + '</select></span></div>' +
      '<div class="field"><label>Giảng viên</label><input class="input" data-kf="gv" value="' + esc(k.gv || '') + '" list="dtGvL" placeholder="Chọn nhân sự hoặc gõ tên"><datalist id="dtGvL">' + staff.map(function (s) { return '<option value="' + esc(s.split(' – ')[0]) + '">' + esc(s) + '</option>'; }).join('') + '</datalist></div>' +
      '<div class="field"><label>Đối tượng phù hợp</label><input class="input" data-kf="dt" value="' + esc(k.dt || '') + '" placeholder="Ví dụ: nhân viên mới, khối văn phòng"></div></div>' +
      '<div class="field"><label>Học phí</label><div class="dt-hp"><label class="radio"><input type="radio" name="dtHp" value="free"' + (k.hp.loai !== 'phi' ? ' checked' : '') + '> Miễn phí</label><label class="radio"><input type="radio" name="dtHp" value="phi"' + (k.hp.loai === 'phi' ? ' checked' : '') + '> Trả phí</label>' + (k.hp.loai === 'phi' ? '<span class="dt-in"><input class="input num" id="dtHpSo" inputmode="numeric" value="' + (+k.hp.so ? fmtInt(+k.hp.so) : '') + '" placeholder="Số tiền"> đồng</span>' : '') + '</div></div></div>' +
      '<div class="card card-pad"><h3 class="dt-sh">Giới thiệu khóa học</h3><div class="dt-rte" data-rte="gt"></div></div>' +
      '<div class="card card-pad"><div class="dt-shr"><h3 class="dt-sh">Lợi ích – học xong bạn sẽ</h3><button class="btn btn-sm" data-act="dt-ltadd">+ Thêm lợi ích</button></div><div class="dt-lt">' + (k.lt.length ? k.lt.map(function (x, i) { return '<div class="dt-lti"><span>✓</span><input class="input" data-lt="' + i + '" value="' + esc(x) + '" placeholder="Ví dụ: Dùng thành thạo app chấm công"><button type="button" class="btn btn-sm dt-ib" data-act="dt-ltdel" data-id="' + i + '" aria-label="Xóa">✕</button></div>'; }).join('') : '<p class="dt-help">Chưa có – bấm "+ Thêm lợi ích".</p>') + '</div></div>' +
      '</div><div class="dt-side2"><div class="card card-pad"><h3 class="dt-sh">Ảnh bìa</h3><div class="dt-cover' + (k.bia ? ' has' : '') + '" style="--dc:' + k.mau_c + (k.bia ? ';background-image:url(\'' + esc(k.bia) + '\')' : '') + '">' + (k.bia ? '' : '<span>' + ic('dt_img', 28) + 'Chưa có ảnh bìa</span>') + '</div>' +
      '<div class="dt-cvb"><label class="btn btn-sm">' + ic('hn_up', 14) + 'Tải ảnh lên<input type="file" accept="image/*" id="dtBiaF" hidden></label><button class="btn btn-sm" data-act="dt-bialink">Dán link ảnh</button>' + (k.bia ? '<button class="btn btn-sm btn-danger-soft" data-act="dt-biadel">Bỏ ảnh</button>' : '') + '</div><small class="faint">Ảnh tự thu nhỏ về 1200 px ngang. Chưa có ảnh thì dùng màu:</small>' +
      '<div class="dt-cols">' + DT_COL.map(function (c) { return '<button type="button" class="dt-colb' + (c === k.mau_c ? ' on' : '') + '" style="background:' + c + '" data-act="dt-col" data-id="' + c + '" aria-label="Chọn màu"></button>'; }).join('') + '</div></div>' +
      '<div class="card card-pad"><h3 class="dt-sh">Video giới thiệu</h3><input class="input" data-kf="vid" value="' + esc(k.vid || '') + '" placeholder="Dán link YouTube, Google Drive, Vimeo"><small class="dt-emb" id="dtVidE">' + dtEmbTxt(k.vid, true) + '</small>' + (em && em.src ? '<div class="dt-vid sm"><iframe src="' + esc(em.src) + '" allowfullscreen loading="lazy" title="Video giới thiệu"></iframe></div>' : '') + '</div></div></div>';
  }
  // Tab 2: Bài giảng – cây chương / bài bên trái, soạn bên phải
  function dtTabBg(ed) {
    var k = ed.k, sel = ed.sel || { c: 0, b: -1 };
    if (sel.c >= k.ch.length) sel.c = k.ch.length - 1; if (sel.c >= 0 && sel.b >= k.ch[sel.c].bai.length) sel.b = k.ch[sel.c].bai.length - 1;
    var tree = '<div class="dt-tree">' + k.ch.map(function (c, ci) {
      var tc = dtTestsAt(k, 'chuong', c.id);
      return '<div class="dt-tc"><button class="dt-ti ch' + (sel.c === ci && sel.b < 0 ? ' on' : '') + '" data-act="dt-sel" data-id="' + ci + '" data-b="-1"><span class="dt-tn">' + (ci + 1) + '</span><span class="dt-tt">' + esc(c.t || 'Chương chưa đặt tên') + '</span><small>' + c.bai.length + ' bài</small></button>' +
        c.bai.map(function (b, bi) { var tb = dtTestsAt(k, 'bai', b.id); return '<button class="dt-ti' + (sel.c === ci && sel.b === bi ? ' on' : '') + '" data-act="dt-sel" data-id="' + ci + '" data-b="' + bi + '">' + ic(b.loai === 'video' ? 'dt_play' : b.loai === 'link' ? 'dt_link' : 'dt_doc', 15) + '<span class="dt-tt">' + (ci + 1) + '.' + (bi + 1) + ' ' + esc(b.t || 'Bài chưa đặt tên') + '</span>' + (tb.length ? '<i class="dt-tq" title="Có bài kiểm tra sau bài này">' + ic('dt_quiz', 13) + '</i>' : '') + '</button>'; }).join('') +
        (tc.length ? '<div class="dt-ti tq">' + ic('dt_quiz', 14) + '<span class="dt-tt">' + esc(tc.map(function (t) { return t.ten; }).join(', ')) + '</span></div>' : '') +
        '<div class="dt-tadd"><button class="lnk-btn" data-act="dt-badd" data-id="' + ci + '" data-t="doc">+ Bài đọc</button><button class="lnk-btn" data-act="dt-badd" data-id="' + ci + '" data-t="link">+ Tài liệu</button><button class="lnk-btn" data-act="dt-badd" data-id="' + ci + '" data-t="video">+ Video</button></div></div>';
    }).join('') + '<button class="btn btn-sm dt-chadd" data-act="dt-chadd">' + ic('td_plus', 14) + 'Thêm chương / chủ đề</button>' + (k.tests.some(function (t) { return t.gan.l === 'khoa'; }) ? '<div class="dt-ti tq">' + ic('dt_quiz', 14) + '<span class="dt-tt">Cuối khóa: ' + esc(dtTestsAt(k, 'khoa').map(function (t) { return t.ten; }).join(', ')) + '</span></div>' : '') + '</div>';
    var pane = '';
    if (sel.c < 0 || !k.ch[sel.c]) pane = '<p class="muted">Bấm "Thêm chương / chủ đề" để bắt đầu.</p>';
    else if (sel.b < 0) {
      var c = k.ch[sel.c];
      pane = '<div class="dt-ph2"><span class="tag tag-info">Chương ' + (sel.c + 1) + '</span><span class="dt-mv">' + dtMvBtns('dt-chmv', sel.c, k.ch.length) + '<button type="button" class="btn btn-sm btn-danger-soft" data-act="dt-chdel" data-id="' + sel.c + '">Xóa chương</button></span></div>' +
        '<div class="field"><label>Tên chương / chủ đề <i class="req">*</i></label><input class="input dt-big" data-cf="t" value="' + esc(c.t) + '"></div><div class="field"><label>Mô tả ngắn <span class="faint">(chữ thường, không bắt buộc)</span></label><textarea class="input" data-cf="mo" rows="3">' + esc(c.mo || '') + '</textarea></div>' +
        '<p class="dt-help">Chương có ' + c.bai.length + ' bài' + (dtTestsAt(k, 'chuong', c.id).length ? ' và bài kiểm tra cuối chương' : '') + '. Thêm bài ở cột bên trái; gắn bài kiểm tra cuối chương ở tab <b>Bài kiểm tra</b>.</p>';
    } else {
      var b = k.ch[sel.c].bai[sel.b], em = b.loai === 'video' ? dtEmbed(b.url) : null;
      pane = '<div class="dt-ph2"><span class="tag tag-info">Bài ' + (sel.c + 1) + '.' + (sel.b + 1) + ' · ' + DT_BT[b.loai] + '</span><span class="dt-mv">' + dtMvBtns('dt-bmv', sel.b, k.ch[sel.c].bai.length) + '<select class="input dt-mvc" data-act2="dt-bto" title="Chuyển sang chương khác">' + k.ch.map(function (c2, i) { return '<option value="' + i + '"' + (i === sel.c ? ' selected' : '') + '>Chương ' + (i + 1) + '</option>'; }).join('') + '</select><button type="button" class="btn btn-sm btn-danger-soft" data-act="dt-bdel">Xóa bài</button></span></div>' +
        '<div class="dt-2b"><div class="field"><label>Tên bài <i class="req">*</i></label><input class="input dt-big" data-bf="t" value="' + esc(b.t) + '"></div><div class="field"><label>Loại bài</label><select class="input" data-bf="loai">' + dtOpts(Object.keys(DT_BT).map(function (x) { return [x, DT_BT[x]]; }), b.loai) + '</select></div><div class="field"><label>Thời lượng</label><span class="dt-in"><input class="input num" type="number" min="0" data-bf="ph" value="' + (+b.ph || '') + '"> phút</span></div></div>' +
        (b.loai !== 'doc' ? '<div class="field"><label>' + (b.loai === 'video' ? 'Link video (YouTube, Google Drive, Vimeo…)' : 'Link tài liệu (Google Drive, OneDrive, trang web…)') + '</label><input class="input" data-bf="url" value="' + esc(b.url || '') + '" placeholder="https://…"><small class="dt-emb" id="dtBE">' + dtEmbTxt(b.url, b.loai === 'video') + '</small></div>' + (em && em.src ? '<div class="dt-vid"><iframe src="' + esc(em.src) + '" allowfullscreen loading="lazy" title="Xem trước video"></iframe></div>' : '') : '') +
        '<div class="field"><label>' + (b.loai === 'doc' ? 'Nội dung bài đọc' : 'Ghi chú cho người học <span class="faint">(không bắt buộc)</span>') + '</label><div class="dt-rte' + (b.loai === 'doc' ? ' big' : '') + '" data-rte="bai"></div></div>' +
        (dtTestsAt(k, 'bai', b.id).length ? '<p class="dt-help">Sau bài này có bài kiểm tra: <b>' + esc(dtTestsAt(k, 'bai', b.id).map(function (t) { return t.ten; }).join(', ')) + '</b> – sửa ở tab Bài kiểm tra.</p>' : '');
    }
    return '<div class="dt-bg"><aside class="card card-pad dt-bgl"><h3 class="dt-sh">Nội dung khóa học</h3><p class="dt-help">Cấp 1: chương / chủ đề · Cấp 2: bài đọc, tài liệu, video.</p>' + tree + '</aside><section class="card card-pad dt-bgr">' + pane + '</section></div>';
  }
  function dtMvBtns(act, i, n) { return '<button type="button" class="btn btn-sm" data-act="' + act + '" data-id="' + i + '" data-d="-1" title="Lên"' + (i ? '' : ' disabled') + '>↑</button><button type="button" class="btn btn-sm" data-act="' + act + '" data-id="' + i + '" data-d="1" title="Xuống"' + (i < n - 1 ? '' : ' disabled') + '>↓</button>'; }
  // Tab 3: Bài kiểm tra – danh sách bên trái, soạn câu hỏi bên phải; gắn sau bài / cuối chương / cuối khóa
  function dtGanOpts(k) { var o = [['khoa|', 'Cuối khóa học']]; k.ch.forEach(function (c, ci) { o.push(['chuong|' + c.id, 'Cuối chương ' + (ci + 1) + ': ' + (c.t || '')]); c.bai.forEach(function (b, bi) { o.push(['bai|' + b.id, '   Sau bài ' + (ci + 1) + '.' + (bi + 1) + ': ' + (b.t || '')]); }); }); return o; }
  function dtTabKt(ed) {
    var k = ed.k, ti = Math.min(ed.ts || 0, k.tests.length - 1), t = k.tests[ti];
    var list = '<div class="dt-tree">' + k.tests.map(function (x, i) { return '<button class="dt-ti' + (i === ti ? ' on' : '') + '" data-act="dt-tsel" data-id="' + i + '">' + ic('dt_quiz', 15) + '<span class="dt-tt"><b>' + esc(x.ten || 'Chưa đặt tên') + '</b><small>' + esc(dtGanTxt(k, x)) + ' · ' + x.cau.length + ' câu</small></span></button>'; }).join('') +
      '<button class="btn btn-sm dt-chadd" data-act="dt-tadd">' + ic('td_plus', 14) + 'Thêm bài kiểm tra</button></div>';
    var pane;
    if (!t) pane = '<div class="dt-empty">' + ic('dt_quiz', 36) + '<b>Khóa học chưa có bài kiểm tra</b><p>Bài kiểm tra có thể đặt sau 1 bài học, cuối chương hoặc cuối khóa. Câu hỏi gồm trắc nghiệm chọn 1, chọn nhiều và tự luận.</p><button class="btn btn-primary" data-act="dt-tadd">' + ic('td_plus', 15) + 'Thêm bài kiểm tra</button></div>';
    else {
      var cau = t.cau.map(function (q, i) {
        var pa = q.loai === 'tl' ? '<div class="field"><label>Gợi ý đáp án (chỉ người chấm thấy)</label><textarea class="input" data-qf="goi_y" rows="2">' + esc(q.goi_y || '') + '</textarea></div>'
          : '<div class="dt-pa">' + (q.pa || []).map(function (p, j) { var on = (q.dung || []).indexOf(j) >= 0; return '<div class="dt-pai' + (on ? ' ok' : '') + '"><label title="Đánh dấu đáp án đúng"><input type="' + (q.loai === 'mot' ? 'radio' : 'checkbox') + '" name="dtq' + i + '" data-qok="' + j + '"' + (on ? ' checked' : '') + '><span>Đúng</span></label><input class="input" data-qpa="' + j + '" value="' + esc(p) + '" placeholder="Phương án ' + String.fromCharCode(65 + j) + '"><button type="button" class="btn btn-sm dt-ib" data-act="dt-padel" data-id="' + i + '" data-j="' + j + '" title="Xóa phương án"' + (q.pa.length > 2 ? '' : ' disabled') + '>✕</button></div>'; }).join('') + '<button type="button" class="lnk-btn" data-act="dt-paadd" data-id="' + i + '">+ Thêm phương án</button></div>';
        return '<div class="dt-blk dt-q" data-qi="' + i + '"><div class="dt-bh"><span class="dt-num q">' + (i + 1) + '</span><select class="input dt-bsel" data-qf="loai">' + dtOpts(Object.keys(DT_QT).map(function (x) { return [x, DT_QT[x]]; }), q.loai) + '</select><label class="dt-pt">Điểm <input class="input num" type="number" min="0.5" step="0.5" data-qf="diem" value="' + (q.diem || 1) + '"></label><span class="dt-mv">' + dtMvBtns('dt-qmv', i, t.cau.length) + '<button type="button" class="btn btn-sm dt-ib" data-act="dt-qdel" data-id="' + i + '" title="Xóa câu hỏi">✕</button></span></div>' +
          '<textarea class="input" data-qf="hoi" rows="2" placeholder="Nội dung câu hỏi">' + esc(q.hoi || '') + '</textarea>' + pa + '</div>';
      }).join('');
      pane = '<div class="dt-ph2"><span class="tag tag-info">Bài kiểm tra ' + (ti + 1) + ' · ' + t.cau.length + ' câu · ' + String(dtPts(t)).replace('.', ',') + ' điểm</span><span class="dt-mv"><button type="button" class="btn btn-sm btn-danger-soft" data-act="dt-tdel" data-id="' + ti + '">Xóa bài kiểm tra</button></span></div>' +
        '<div class="dt-2b"><div class="field"><label>Tên bài kiểm tra <i class="req">*</i></label><input class="input dt-big" data-tf="ten" value="' + esc(t.ten) + '"></div><div class="field"><label>Gắn vào</label><select class="input" data-tf="gan">' + dtOpts(dtGanOpts(k), t.gan.l + '|' + (t.gan.id || '')) + '</select></div><div class="field"><label>Thời gian làm</label><span class="dt-in"><input class="input num" type="number" min="0" data-tf="tg" value="' + (+t.tg || 0) + '"> phút</span><small class="faint">0 = không giới hạn</small></div></div>' +
        '<p class="dt-help">Điểm đạt, số lần làm, cách lấy điểm đặt chung ở tab <b>Cài đặt</b>. Trắc nghiệm phần mềm tự chấm; câu tự luận người quản lý chấm ở <b>Theo dõi học tập</b>.</p>' + cau +
        '<div class="dt-add2" style="margin-top:10px"><button class="btn btn-sm" data-act="dt-qadd" data-id="mot">+ Trắc nghiệm chọn 1</button><button class="btn btn-sm" data-act="dt-qadd" data-id="nhieu">+ Trắc nghiệm chọn nhiều</button><button class="btn btn-sm" data-act="dt-qadd" data-id="tl">+ Câu tự luận</button></div>';
    }
    return '<div class="dt-bg"><aside class="card card-pad dt-bgl"><h3 class="dt-sh">Bài kiểm tra</h3>' + list + '</aside><section class="card card-pad dt-bgr">' + pane + '</section></div>';
  }
  // Tab 4: Cài đặt
  function dtTabCd(ed) {
    var k = ed.k, d = k.cd, sc = d.sc, multi = S.units.length > 1, th = d.thang;
    var hasLT = k.tests.some(function (t) { return t.gan.l !== 'khoa'; }), hasF = k.tests.some(function (t) { return t.gan.l === 'khoa'; });
    var usOpt = multi ? '<div class="field"><label>Công ty</label><div class="dt-chips">' + S.units.map(function (u) { var on = !sc.us.length || sc.us.indexOf(u.id) >= 0; return '<label class="dt-chip' + (on ? ' on' : '') + '"><input type="checkbox" data-sc="us" value="' + u.id + '"' + (on ? ' checked' : '') + '>' + esc(shortUnit(u.name)) + '</label>'; }).join('') + '</div></div>' : '';
    var cds = dtAllCd(sc.pb).concat(sc.cd.filter(function (c) { return dtAllCd(sc.pb).indexOf(c) < 0; }));
    var sw = function (f, on, lab, sub) { return '<label class="dt-sw"><input type="checkbox" data-df="' + f + '"' + (on ? ' checked' : '') + '><span class="dt-swk"></span><span><b>' + lab + '</b>' + (sub ? '<small>' + sub + '</small>' : '') + '</span></label>'; };
    var num = function (f, v, max, unit) { return '<span class="dt-in"><input class="input num" type="number" min="0" max="' + max + '" step="' + (max > 10 ? 1 : 0.5) + '" data-df="' + f + '" value="' + v + '"> ' + unit + '</span>'; };
    return '<div class="dt-cdg">' +
      '<div class="card card-pad"><h3 class="dt-sh">Trạng thái khóa học</h3>' + sw('on', d.on, 'Mở khóa học', 'Tắt: không giao thêm, giữ nguyên kết quả đã có') + sw('bb', d.bb, 'Bắt buộc', 'Nhắc ở Việc cần xử lý khi quá hạn') + '<label class="dt-sw"><input type="checkbox" data-hnk' + (k.hn ? ' checked' : '') + '><span class="dt-swk"></span><span><b>Dùng làm khóa Hội nhập</b><small>Người mới hoàn thành khóa → bước "Tìm hiểu công ty, nội quy và chế độ trên app" trong hành trình hội nhập tự đánh dấu xong</small></span></label></div>' +
      '<div class="card card-pad"><h3 class="dt-sh">Cách chấm điểm</h3><div class="dt-2"><div class="field"><label>Thang điểm</label><select class="input" data-df="thang">' + dtOpts([[10, 'Thang 10'], [100, 'Thang 100']], th) + '</select></div><div class="field"><label>Lấy điểm khi làm nhiều lần</label><select class="input" data-df="lay">' + dtOpts([['cao', 'Lần cao nhất'], ['cuoi', 'Lần gần nhất']], d.lay) + '</select></div>' +
      '<div class="field"><label>Số lần làm tối đa</label>' + num('lan', +d.lan || 0, 20, 'lần') + '<small class="faint">0 = không giới hạn</small></div><div class="field" style="align-self:center">' + sw('dapan', d.dapan, 'Cho xem đáp án sau khi nộp') + sw('tron', d.tron, 'Trộn thứ tự câu hỏi') + '</div></div></div>' +
      '<div class="card card-pad"><h3 class="dt-sh">Hoàn thành một bài học khi</h3><div class="dt-rules">' +
      '<div class="dt-rule">' + ic('dt_doc', 18) + '<b>Bài đọc</b><select class="input" data-df="hb.doc">' + dtOpts([['xn', 'Bấm nút "Tôi đã đọc xong"'], ['mo', 'Mở bài là xong']], d.hb.doc) + '</select></div>' +
      '<div class="dt-rule">' + ic('dt_link', 18) + '<b>Tài liệu</b><select class="input" data-df="hb.link">' + dtOpts([['mo', 'Bấm mở tài liệu là xong'], ['xn', 'Bấm nút "Tôi đã xem xong"']], d.hb.link) + '</select></div>' +
      '<div class="dt-rule">' + ic('dt_play', 18) + '<b>Video</b><span>Xem tối thiểu ' + num('hb.vid', +d.hb.vid || 0, 100, '% thời lượng') + '</span><small>YouTube, Vimeo tự tính % đã xem; Google Drive và link khác: nhân viên bấm "Tôi đã xem xong".</small></div>' +
      '<div class="dt-rule' + (hasLT ? '' : ' off') + '">' + ic('dt_quiz', 18) + '<b>Bài có bài kiểm tra cuối bài, cuối chương</b><span>Đạt từ ' + num('hb.kt', d.hb.kt, th, 'điểm / ' + th) + '</span>' + (hasLT ? '' : '<small>Khóa chưa có bài kiểm tra sau bài / cuối chương.</small>') + '</div></div></div>' +
      '<div class="card card-pad"><h3 class="dt-sh">Hoàn thành khóa học khi</h3><div class="dt-rules">' +
      '<div class="dt-rule">' + ic('dt_ch', 18) + '<b>Hoàn thành bài học</b><span>Tối thiểu ' + num('hk.pct', +d.hk.pct || 0, 100, '% bài học toàn khóa') + '</span><small>Tính cả bài kiểm tra sau bài, cuối chương (đạt mới tính).</small></div>' +
      '<div class="dt-rule' + (hasF ? '' : ' off') + '">' + ic('dt_quiz', 18) + '<b>Bài kiểm tra cuối khóa</b><span>Đạt từ ' + num('hk.kt', d.hk.kt, th, 'điểm / ' + th) + '</span>' + (hasF ? '' : '<small>Khóa chưa có bài kiểm tra cuối khóa – thêm ở tab Bài kiểm tra.</small>') + '</div>' +
      '<div class="dt-rule">' + ic('dt_sign', 18) + '<b>Xác nhận cuối khóa</b>' + sw('hk.xn.on', d.hk.xn.on, 'Yêu cầu nhân viên xác nhận', 'Lưu ngày giờ xác nhận làm bằng chứng') + (d.hk.xn.on ? '<textarea class="input" data-df="hk.xn.nd" rows="2">' + esc(d.hk.xn.nd || '') + '</textarea>' : '') + '</div></div></div>' +
      '<div class="card card-pad"><h3 class="dt-sh">Giao cho ai</h3>' + usOpt +
      '<div class="field"><label>Phòng ban <span class="faint">(không chọn = tất cả)</span></label>' + dtChips('pb', dtAllPb(), sc.pb) + '</div>' +
      '<details class="dt-det"' + (sc.cd.length || ed.cdOpen ? ' open' : '') + '><summary>Vị trí <span class="faint">' + (sc.cd.length ? 'đã chọn ' + sc.cd.length : 'không chọn = tất cả') + (sc.pb.length ? ' · trong phòng ban đã chọn' : '') + '</span></summary>' + dtChips('cd', cds, sc.cd) + '</details>' +
      sw('sc.moi', sc.moi, 'Chỉ người mới vào làm', 'Người vào làm từ ngày giao khóa trở đi') +
      '<div class="dt-3"><div class="field"><label>Ngày giao khóa</label>' + dateInput('dtGiao', d.giao) + '</div><div class="field"><label>Hạn hoàn thành</label>' + num('han', +d.han || 0, 365, 'ngày') + '<small class="faint">' + (sc.moi ? 'từ ngày vào làm' : 'từ ngày giao') + '; 0 = không hạn</small></div><div class="field"><label>Học lại định kỳ</label><select class="input" data-df="lap">' + dtOpts([[0, 'Không'], [6, 'Mỗi 6 tháng'], [12, 'Mỗi 12 tháng'], [24, 'Mỗi 24 tháng']], +d.lap || 0) + '</select></div></div>' +
      '<div class="dt-cnt" id="dtCnt"></div></div></div>';
  }
  /* ---------------- Gắn sự kiện trình soạn ---------------- */
  function dtEdK() { return PS.dt && PS.dt.ed ? PS.dt.ed.k : null; }
  function dtDirty() { if (PS.dt.ed && !PS.dt.ed.dirty) { PS.dt.ed.dirty = true; var x = $('.dt-dirty'); if (x) x.textContent = 'Có thay đổi chưa lưu'; } }
  function dtRe() { var y = window.scrollY; render(); window.scrollTo(0, y); }
  function dtSetPath(o, p, v) { var a = p.split('.'), x = o; for (var i = 0; i < a.length - 1; i++) x = x[a[i]]; x[a[a.length - 1]] = v; }
  function dtCount() {
    var k = dtEdK(), el = $('#dtCnt'); if (!k || !el) return;
    var R = refDate(), n = 0, by = {}; S.units.forEach(function (u) { var mat = HR.maternitySet(u.data, R); (u.data.NV || []).forEach(function (e) { if (!e['Mã NV'] || HR.staffState(e, R, mat) === 'left') return; if (dtApplies(k, u, e)) { n++; by[shortUnit(u.name)] = (by[shortUnit(u.name)] || 0) + 1; } }); });
    el.innerHTML = k.cd.sc.moi ? '<b>Chỉ người mới</b> vào làm từ ' + vn(k.cd.giao) + ' trở đi' + (n ? ' · hiện có ' + n + ' người' : '') : '<b>' + n + ' người</b> phải học' + (S.units.length > 1 && n ? ' (' + Object.keys(by).map(function (x) { return x + ' ' + by[x]; }).join(', ') + ')' : '');
  }
  function dtBindEditor() {
    var ed = PS.dt.ed, k = ed.k;
    $$('[data-kf]').forEach(function (el) { el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', function () { var f = el.getAttribute('data-kf'); dtSetPath(k, f, f === 'tl.n' ? Math.max(0, +el.value || 0) : el.value); dtDirty(); if (f === 'vid') { var x = $('#dtVidE'); if (x) x.innerHTML = dtEmbTxt(el.value, true); } if (f === 'ten') { var t = $('.dt-edt span'); if (t) t.textContent = el.value || 'Chưa đặt tên'; } }); if (el.getAttribute('data-kf') === 'vid') el.addEventListener('change', dtRe); });
    $$('[name="dtHp"]').forEach(function (r) { r.addEventListener('change', function () { k.hp.loai = r.value; dtDirty(); dtRe(); if (r.value === 'phi') setTimeout(function () { var x = $('#dtHpSo'); if (x) x.focus(); }, 30); }); });
    var hs = $('#dtHpSo'); if (hs) hs.addEventListener('input', function () { var v = hs.value.replace(/\D/g, ''); k.hp.so = +v || 0; hs.value = v ? fmtInt(+v) : ''; dtDirty(); });
    $$('[data-lt]').forEach(function (el) { el.addEventListener('input', function () { k.lt[+el.getAttribute('data-lt')] = el.value; dtDirty(); }); });
    var bf = $('#dtBiaF'); if (bf) bf.addEventListener('change', function () { var f = bf.files[0]; if (!f) return; dtImg(f, function (url) { k.bia = url; dtDirty(); dtRe(); }); });
    // khung soạn thảo
    $$('[data-rte]').forEach(function (h) {
      var w = h.getAttribute('data-rte');
      if (w === 'gt') dtRte(h, k.gt, function (v) { k.gt = v; dtDirty(); }, k, 'Khóa học này giúp gì cho người học, học những gì…');
      if (w === 'bai') { var b = k.ch[ed.sel.c].bai[ed.sel.b]; dtRte(h, b.html, function (v) { b.html = v; dtDirty(); }, k, b.loai === 'doc' ? 'Soạn nội dung bài đọc – bấm "Trường liên kết" để chèn dữ liệu có sẵn (họ tên, sơ đồ tổ chức, giờ làm việc…)' : 'Ghi chú thêm cho người học…'); }
    });
    // chương / bài
    $$('[data-cf]').forEach(function (el) { el.addEventListener('input', function () { k.ch[ed.sel.c][el.getAttribute('data-cf')] = el.value; dtDirty(); if (el.getAttribute('data-cf') === 't') { var t = $('.dt-ti.ch.on .dt-tt'); if (t) t.textContent = el.value || 'Chương chưa đặt tên'; } }); });
    $$('[data-bf]').forEach(function (el) {
      el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', function () {
        var b = k.ch[ed.sel.c].bai[ed.sel.b], f = el.getAttribute('data-bf'); b[f] = f === 'ph' ? Math.max(0, +el.value || 0) : el.value; dtDirty();
        if (f === 'loai') dtRe(); else if (f === 'url') { var x = $('#dtBE'); if (x) x.innerHTML = dtEmbTxt(b.url, b.loai === 'video'); } else if (f === 't') { var t = $('.dt-ti.on:not(.ch) .dt-tt'); if (t) t.textContent = (ed.sel.c + 1) + '.' + (ed.sel.b + 1) + ' ' + (el.value || 'Bài chưa đặt tên'); }
      });
      if (el.getAttribute('data-bf') === 'url') el.addEventListener('change', dtRe);
    });
    var mv = $('[data-act2="dt-bto"]'); if (mv) mv.addEventListener('change', function () { var to = +mv.value, b = k.ch[ed.sel.c].bai.splice(ed.sel.b, 1)[0]; k.ch[to].bai.push(b); ed.sel = { c: to, b: k.ch[to].bai.length - 1 }; dtDirty(); dtRe(); });
    // bài kiểm tra
    var t = k.tests[Math.min(ed.ts || 0, k.tests.length - 1)];
    $$('[data-tf]').forEach(function (el) { el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', function () { var f = el.getAttribute('data-tf'); if (f === 'gan') { var a = el.value.split('|'); t.gan = { l: a[0], id: a[1] || '' }; dtDirty(); dtRe(); return; } t[f] = f === 'tg' ? Math.max(0, +el.value || 0) : el.value; dtDirty(); }); });
    $$('[data-qi]').forEach(function (box) {
      var q = t.cau[+box.getAttribute('data-qi')];
      $$('[data-qf]', box).forEach(function (el) { el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', function () { var f = el.getAttribute('data-qf'); if (f === 'loai') { q.loai = el.value; if (q.loai !== 'tl' && (!q.pa || q.pa.length < 2)) q.pa = ['', '']; if (q.loai === 'mot') q.dung = (q.dung || []).slice(0, 1); if (q.loai !== 'tl' && !q.dung) q.dung = []; dtDirty(); dtRe(); return; } q[f] = f === 'diem' ? Math.max(0.5, +el.value || 1) : el.value; dtDirty(); }); });
      $$('[data-qpa]', box).forEach(function (el) { el.addEventListener('input', function () { q.pa[+el.getAttribute('data-qpa')] = el.value; dtDirty(); }); });
      $$('[data-qok]', box).forEach(function (el) { el.addEventListener('change', function () { var j = +el.getAttribute('data-qok'); if (q.loai === 'mot') q.dung = [j]; else { q.dung = (q.dung || []).filter(function (x) { return x !== j; }); if (el.checked) q.dung.push(j); q.dung.sort(); } $$('.dt-pai', box).forEach(function (p, pi) { p.classList.toggle('ok', q.dung.indexOf(pi) >= 0); }); dtDirty(); }); });
    });
    // cài đặt
    $$('[data-df]').forEach(function (el) {
      el.addEventListener(el.type === 'checkbox' || el.tagName === 'SELECT' ? 'change' : 'input', function () {
        var f = el.getAttribute('data-df'), v = el.type === 'checkbox' ? el.checked : el.value;
        if (el.type === 'number' || /^(thang|lap)$/.test(f)) v = Math.max(0, +v || 0);
        if (f === 'thang' && v !== k.cd.thang) { var r = v / k.cd.thang; k.cd.hb.kt = Math.round(k.cd.hb.kt * r * 10) / 10; k.cd.hk.kt = Math.round(k.cd.hk.kt * r * 10) / 10; }
        dtSetPath(k.cd, f, v); dtDirty(); if (f === 'thang' || f === 'hk.xn.on' || f === 'sc.moi') dtRe(); else dtCount();
      });
    });
    var gi = $('#dtGiao'); if (gi) gi.addEventListener('change', function () { var v = HR.parseVn(gi.value); if (v) { k.cd.giao = v; dtDirty(); dtCount(); } });
    var hk = $('[data-hnk]'); if (hk) hk.addEventListener('change', function () { k.hn = hk.checked ? 1 : 0; dtDirty(); });
    $$('[data-sc]').forEach(function (el) {
      el.addEventListener('change', function () {
        var f = el.getAttribute('data-sc'), sc = k.cd.sc;
        if (f === 'us') { var all = $$('[data-sc="us"]').filter(function (c) { return c.checked; }).map(function (c) { return c.value; }); if (!all.length) { el.checked = true; toast('Chọn ít nhất 1 công ty', 'info'); return; } sc.us = all.length === S.units.length ? [] : all; }
        else sc[f] = $$('[data-sc="' + f + '"]').filter(function (c) { return c.checked; }).map(function (c) { return c.value; });
        el.parentNode.classList.toggle('on', el.checked); dtDirty(); dtCount(); if (f === 'pb') { var dd = $('.dt-det'); ed.cdOpen = dd && dd.open; dtRe(); }
      });
    });
    dtCount();
  }
  // Ảnh bìa: thu nhỏ về 1200 px ngang, lưu JPEG
  function dtImg(file, cb) {
    if (!/^image\//.test(file.type)) { toast('Chọn file ảnh (JPG, PNG…)', 'err'); return; }
    var rd = new FileReader(); rd.onload = function () { var im = new Image(); im.onload = function () { var w = Math.min(1200, im.width), h = Math.round(im.height * w / im.width), c = document.createElement('canvas'); c.width = w; c.height = h; c.getContext('2d').drawImage(im, 0, 0, w, h); cb(c.toDataURL('image/jpeg', 0.82)); }; im.onerror = function () { toast('Không đọc được ảnh', 'err'); }; im.src = rd.result; }; rd.readAsDataURL(file);
  }
  function dtMove(arr, i, d) { var j = i + d; if (j < 0 || j >= arr.length) return false; var x = arr[i]; arr[i] = arr[j]; arr[j] = x; return true; }
  ACTS['dt-tab'] = function (a, id) { PS.dt.ed.tab = id; dtRe(); window.scrollTo(0, 0); };
  ACTS['dt-col'] = function (a, c) { dtEdK().mau_c = c; dtDirty(); dtRe(); };
  ACTS['dt-bialink'] = function () { var m = modal('Dán link ảnh bìa', '', '<div class="field"><label>Link ảnh (https://…)</label><input class="input" id="dtBL" placeholder="https://"></div><div class="link-row" style="justify-content:flex-end"><button class="btn" data-close>Hủy</button><button class="btn btn-primary" id="dtBLok">Dùng ảnh này</button></div>', true); $('#dtBLok', m).addEventListener('click', function () { var v = $('#dtBL', m).value.trim(); if (!/^https?:\/\//.test(v)) { toast('Link cần bắt đầu bằng https://', 'err'); return; } dtEdK().bia = v; dtDirty(); m.close(); dtRe(); }); };
  ACTS['dt-biadel'] = function () { dtEdK().bia = ''; dtDirty(); dtRe(); };
  ACTS['dt-ltadd'] = function () { dtEdK().lt.push(''); dtDirty(); dtRe(); setTimeout(function () { var x = $$('[data-lt]'); if (x.length) x[x.length - 1].focus(); }, 40); };
  ACTS['dt-ltdel'] = function (a, i) { dtEdK().lt.splice(+i, 1); dtDirty(); dtRe(); };
  ACTS['dt-sel'] = function (a, ci) { PS.dt.ed.sel = { c: +ci, b: +a.getAttribute('data-b') }; dtRe(); };
  ACTS['dt-chadd'] = function () { var k = dtEdK(); k.ch.push({ id: dtId('c'), t: 'Chương ' + (k.ch.length + 1), mo: '', bai: [] }); PS.dt.ed.sel = { c: k.ch.length - 1, b: -1 }; dtDirty(); dtRe(); setTimeout(function () { var x = $('[data-cf="t"]'); if (x) { x.focus(); x.select(); } }, 40); };
  ACTS['dt-chmv'] = function (a, i) { var d = +a.getAttribute('data-d'); if (dtMove(dtEdK().ch, +i, d)) PS.dt.ed.sel = { c: +i + d, b: -1 }; dtDirty(); dtRe(); };
  ACTS['dt-chdel'] = function (a, i) { var k = dtEdK(), c = k.ch[+i]; confirmBox('Xóa chương "' + (c.t || '') + '"?', c.bai.length ? 'Chương có ' + c.bai.length + ' bài – các bài này cũng bị xóa.' : 'Chương chưa có bài nào.', 'Xóa chương', function () { k.ch.splice(+i, 1); PS.dt.ed.sel = { c: Math.max(0, +i - 1), b: -1 }; dtDirty(); dtRe(); }); };
  ACTS['dt-badd'] = function (a, ci) { var k = dtEdK(), t = a.getAttribute('data-t'), c = k.ch[+ci]; c.bai.push({ id: dtId('b'), loai: t, t: t === 'video' ? 'Video' : t === 'link' ? 'Tài liệu' : 'Bài đọc ' + (c.bai.length + 1), url: '', html: '', ph: 0 }); PS.dt.ed.sel = { c: +ci, b: c.bai.length - 1 }; dtDirty(); dtRe(); setTimeout(function () { var x = $('[data-bf="t"]'); if (x) { x.focus(); x.select(); } }, 40); };
  ACTS['dt-bmv'] = function (a, i) { var s = PS.dt.ed.sel, d = +a.getAttribute('data-d'); if (dtMove(dtEdK().ch[s.c].bai, +i, d)) s.b = +i + d; dtDirty(); dtRe(); };
  ACTS['dt-bdel'] = function () { var k = dtEdK(), s = PS.dt.ed.sel, b = k.ch[s.c].bai[s.b]; confirmBox('Xóa bài "' + (b.t || '') + '"?', 'Nội dung bài này sẽ mất' + (dtTestsAt(k, 'bai', b.id).length ? '; bài kiểm tra sau bài này chuyển thành "chưa gắn".' : '.'), 'Xóa bài', function () { k.ch[s.c].bai.splice(s.b, 1); s.b = Math.min(s.b, k.ch[s.c].bai.length - 1); dtDirty(); dtRe(); }); };
  ACTS['dt-tsel'] = function (a, i) { PS.dt.ed.ts = +i; dtRe(); };
  ACTS['dt-tadd'] = function () { var k = dtEdK(); k.tests.push({ id: dtId('t'), ten: k.tests.some(function (t) { return t.gan.l === 'khoa'; }) ? 'Bài kiểm tra ' + (k.tests.length + 1) : 'Bài kiểm tra cuối khóa', gan: { l: 'khoa', id: '' }, tg: 0, cau: [] }); PS.dt.ed.ts = k.tests.length - 1; dtDirty(); dtRe(); };
  ACTS['dt-tdel'] = function (a, i) { var k = dtEdK(), t = k.tests[+i]; confirmBox('Xóa "' + (t.ten || 'bài kiểm tra') + '"?', t.cau.length + ' câu hỏi sẽ mất.', 'Xóa', function () { k.tests.splice(+i, 1); PS.dt.ed.ts = Math.max(0, +i - 1); dtDirty(); dtRe(); }); };
  function dtCurT() { var k = dtEdK(); return k.tests[Math.min(PS.dt.ed.ts || 0, k.tests.length - 1)]; }
  ACTS['dt-qadd'] = function (a, t) { var T = dtCurT(); T.cau.push(t === 'tl' ? { id: dtId('q'), loai: 'tl', hoi: '', goi_y: '', diem: 2 } : { id: dtId('q'), loai: t, hoi: '', pa: ['', '', ''], dung: [], diem: 1 }); dtDirty(); dtRe(); setTimeout(function () { var x = $$('[data-qf="hoi"]'); if (x.length) { x[x.length - 1].focus(); x[x.length - 1].scrollIntoView({ block: 'center', behavior: 'smooth' }); } }, 40); };
  ACTS['dt-qmv'] = function (a, i) { dtMove(dtCurT().cau, +i, +a.getAttribute('data-d')); dtDirty(); dtRe(); };
  ACTS['dt-qdel'] = function (a, i) { dtCurT().cau.splice(+i, 1); dtDirty(); dtRe(); };
  ACTS['dt-paadd'] = function (a, i) { dtCurT().cau[+i].pa.push(''); dtDirty(); dtRe(); };
  ACTS['dt-padel'] = function (a, i) { var q = dtCurT().cau[+i], j = +a.getAttribute('data-j'); q.pa.splice(j, 1); q.dung = (q.dung || []).filter(function (x) { return x !== j; }).map(function (x) { return x > j ? x - 1 : x; }); dtDirty(); dtRe(); };
  ACTS['dt-save'] = function () {
    var ed = PS.dt.ed, k = ed.k, E = dtErrs(k), all = [].concat(E.info, E.bg, E.kt, E.cd);
    if (all.length) { var tab = ['info', 'bg', 'kt', 'cd'].filter(function (t) { return E[t].length; })[0]; ed.tab = tab; dtRe(); toast('Chưa lưu được – còn ' + all.length + ' chỗ cần sửa', 'err', all.slice(0, 4).join(' · ') + (all.length > 4 ? ' …' : '')); return; }
    k.ten = k.ten.trim(); k.lt = k.lt.filter(function (x) { return String(x).trim(); }); k.upd = HR.isoToday(); if (!k.at) k.at = k.upd; k.by = typeof ccUser === 'function' ? ccUser() : '';
    var L = dtKh(), i = L.map(function (x) { return x.id; }).indexOf(k.id); if (i >= 0) L[i] = k; else L.push(k);
    PS.dt.ed = null; dtRteDestroy(); dtSave((ed.isNew ? 'Tạo khóa ' : 'Sửa khóa ') + k.ten); toast(ed.isNew ? 'Đã tạo khóa học' : 'Đã lưu khóa học', 'ok', k.ten); render(); window.scrollTo(0, 0);
  };
  ACTS['dt-cancel'] = function () { var ed = PS.dt.ed; var leave = function () { PS.dt.ed = null; dtRteDestroy(); render(); window.scrollTo(0, 0); }; if (ed && ed.dirty) confirmBox('Bỏ các thay đổi chưa lưu?', 'Nội dung vừa soạn sẽ mất.', 'Bỏ thay đổi', leave); else leave(); };
  ACTS['dt-prev'] = function () { var k = dtEdK(); if (k) dtPlayer(k, true); };
  ACTS['dt-view'] = function (a, id) { var k = dtById(id); if (k) dtPlayer(k, true); };

  /* ---------------- Xem thử như nhân viên ---------------- */
  function dtSteps(k) {
    var S2 = [{ t: 'intro' }];
    k.ch.forEach(function (c, ci) { S2.push({ t: 'ch', c: c, ci: ci }); c.bai.forEach(function (b, bi) { S2.push({ t: 'b', b: b, c: c, ci: ci, bi: bi }); dtTestsAt(k, 'bai', b.id).forEach(function (x) { S2.push({ t: 'kt', x: x, lv: 'bai' }); }); }); dtTestsAt(k, 'chuong', c.id).forEach(function (x) { S2.push({ t: 'kt', x: x, lv: 'chuong' }); }); });
    dtTestsAt(k, 'khoa').forEach(function (x) { S2.push({ t: 'kt', x: x, lv: 'khoa' }); });
    if (k.cd.hk.xn.on) S2.push({ t: 'xn' }); S2.push({ t: 'end' }); return S2;
  }
  function dtPlayer(k, demo) {
    k = dtNorm(JSON.parse(JSON.stringify(k))); var d = k.cd, cx = dtCtx(k), steps = dtSteps(k);
    var st = { i: 0, r: { bd: HR.isoToday(), bai: [], tests: {} }, ans: {}, vid: {}, timer: null };
    var m = modal(k.ten, demo ? 'Xem thử như nhân viên' + (cx.e ? ' – ' + cx.e['Họ và tên'] : '') + ' · không lưu kết quả' : '', '<div class="dt-pl"><nav class="dt-nav" id="dtNav"></nav><section class="dt-view" id="dtView"></section></div>');
    m.querySelector('.modal').classList.add('dt-modal');
    var _close = m.close; m.close = function () { window.removeEventListener('message', onMsg); clearInterval(st.timer); _close(); };
    function done(b) { return st.r.bai.indexOf(b.id) >= 0; }
    function mark(b) { if (!done(b)) st.r.bai.push(b.id); }
    function tRes(x) { var r = st.r.tests[x.id]; return r ? dtScoreT(x, r.ans, null) : null; }
    function need(lv) { return dtNeed(k, lv === 'khoa' ? d.hk.kt : d.hb.kt); }
    function navHtml() {
      var ev = dtEval(k, st.r);
      return steps.map(function (s, i) {
        if (s.t === 'ch') return '<div class="dt-nch">' + (s.ci + 1) + '. ' + esc(s.c.t) + '</div>';
        var lab, icn, ok = false;
        if (s.t === 'intro') { lab = 'Giới thiệu khóa học'; icn = 'info'; ok = true; }
        else if (s.t === 'b') { lab = (s.ci + 1) + '.' + (s.bi + 1) + ' ' + s.b.t; icn = s.b.loai === 'video' ? 'dt_play' : s.b.loai === 'link' ? 'dt_link' : 'dt_doc'; ok = done(s.b); }
        else if (s.t === 'kt') { lab = s.x.ten; icn = 'dt_quiz'; var rr = tRes(s.x); ok = rr && !rr.wait && rr.pct >= need(s.lv); }
        else if (s.t === 'xn') { lab = 'Xác nhận cuối khóa'; icn = 'dt_sign'; ok = !!st.r.xn; }
        else { lab = 'Hoàn thành'; icn = 'dt_flag'; ok = ev.st === 'dat'; }
        return '<button type="button" class="dt-ni' + (s.t === 'b' || s.t === 'kt' && s.lv !== 'khoa' ? ' in' : '') + (i === st.i ? ' on' : '') + (ok ? ' ok' : '') + '" data-ni="' + i + '">' + ic(ok && s.t !== 'intro' ? 'dt_ok' : icn, 16) + '<span>' + esc(lab) + '</span></button>';
      }).join('') + '<div class="dt-nprog"><span class="dt-bar"><i style="width:' + ev.prog + '%"></i></span><small>Hoàn thành ' + ev.prog + '% bài học</small></div>';
    }
    function nextBtn() { var j = st.i + 1; while (j < steps.length && steps[j].t === 'ch') j++; return j < steps.length ? '<button class="btn btn-primary" data-go2="' + j + '">' + (steps[j].t === 'kt' ? 'Làm bài kiểm tra →' : steps[j].t === 'end' ? 'Xem kết quả →' : 'Tiếp tục →') + '</button>' : ''; }
    function foot(extra) { var j = st.i - 1; while (j > 0 && steps[j].t === 'ch') j--; return '<div class="dt-vf">' + (st.i ? '<button class="btn" data-go2="' + j + '">← Trước</button>' : '<span></span>') + '<span class="dt-vfr">' + (extra || '') + nextBtn() + '</span></div>'; }
    function viewHtml() {
      var s = steps[st.i];
      if (s.t === 'intro') {
        var em = k.vid ? dtEmbed(k.vid) : null;
        return (k.bia ? '<div class="dt-pcov" style="background-image:url(\'' + esc(k.bia) + '\')"></div>' : '<div class="dt-pcov c" style="--dc:' + k.mau_c + '"><b>' + esc(k.ten) + '</b></div>') +
          '<div class="dt-vh"><h3>' + esc(k.ten) + '</h3></div><div class="dt-meta">' + [dtTlTxt(k) ? ic('hn_clock', 15) + dtTlTxt(k) : '', k.gv ? ic('dt_user', 15) + 'Giảng viên: ' + esc(k.gv) : '', k.dt ? ic('nv', 15) + esc(k.dt) : '', ic('dt_ch', 15) + k.ch.length + ' chương · ' + dtNb(k) + ' bài', k.hp.loai === 'phi' ? 'Học phí ' + fmtInt(+k.hp.so || 0) + ' đ' : 'Miễn phí'].filter(Boolean).map(function (x) { return '<span>' + x + '</span>'; }).join('') + '</div>' +
          (em && em.src ? '<div class="dt-vid"><iframe src="' + esc(em.src) + '" allowfullscreen loading="lazy" title="Video giới thiệu"></iframe></div>' : '') +
          (k.gt ? '<div class="dt-md">' + dtRender(k.gt, cx) + '</div>' : '') + (k.lt.length ? '<h4 class="dt-h4">Học xong bạn sẽ</h4><ul class="dt-ben">' + k.lt.map(function (x) { return '<li>' + ic('dt_ok', 16) + esc(x) + '</li>'; }).join('') + '</ul>' : '') +
          '<div class="dt-howto">' + ic('info', 16) + '<span>Hoàn thành khóa khi: học tối thiểu <b>' + d.hk.pct + '%</b> bài học' + (dtTestsAt(k, 'khoa').length ? ', bài kiểm tra cuối khóa đạt từ <b>' + String(d.hk.kt).replace('.', ',') + '/' + d.thang + '</b>' : '') + (d.hk.xn.on ? ', xác nhận cuối khóa' : '') + '.</span></div>' + foot();
      }
      if (s.t === 'b') {
        var b = s.b, e2 = b.loai !== 'doc' ? dtEmbed(b.url, true) : null, body = '', act = '';
        if (b.loai === 'video') { body = e2 && e2.src ? '<div class="dt-vid"><iframe id="dtVF" src="' + esc(e2.src) + '" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen title="' + esc(b.t) + '"></iframe></div>' + (e2.track ? '<div class="dt-vp" id="dtVP"><span class="dt-bar"><i style="width:' + Math.round((st.vid[b.id] || 0) * 100) + '%"></i></span><small>Đã xem ' + Math.round((st.vid[b.id] || 0) * 100) + '% · cần ' + d.hb.vid + '%</small></div>' : '') : b.url ? '<a class="btn btn-primary" href="' + esc(b.url) + '" target="_blank" rel="noopener">' + ic('dt_play', 15) + 'Mở video</a>' : '<div class="dt-ph">' + ic('dt_play', 34) + '<b>Chưa có link video</b><small>Phòng nhân sự dán link ở Kho khóa học → Sửa → Bài giảng</small></div>';
          if ((!e2 || !e2.track) && !done(b)) act = '<button class="btn" data-mark="1">' + ic('dt_ok', 15) + 'Tôi đã xem xong</button>'; }
        if (b.loai === 'link') { body = b.url ? '<a class="dt-lnk" href="' + esc(b.url) + '" target="_blank" rel="noopener" data-open="1">' + ic('dt_link', 20) + '<span><b>' + esc(b.t) + '</b><small>' + esc(b.url.replace(/^https?:\/\//, '').slice(0, 60)) + '</small></span><em>Mở →</em></a>' : '<div class="dt-ph">' + ic('dt_link', 30) + '<b>Chưa có link tài liệu</b></div>'; if (d.hb.link === 'xn' && !done(b)) act = '<button class="btn" data-mark="1">' + ic('dt_ok', 15) + 'Tôi đã xem xong</button>'; }
        if (b.loai === 'doc' && d.hb.doc === 'xn' && !done(b)) act = '<button class="btn" data-mark="1">' + ic('dt_ok', 15) + 'Tôi đã đọc xong</button>';
        if (b.loai === 'doc' && d.hb.doc === 'mo') mark(b);
        return '<div class="dt-vh"><small>Chương ' + (s.ci + 1) + ' · Bài ' + (s.ci + 1) + '.' + (s.bi + 1) + ' · ' + DT_BT[b.loai] + (+b.ph ? ' · ' + b.ph + ' phút' : '') + (done(b) ? ' · <span class="ok">✓ Đã xong</span>' : '') + '</small><h3>' + esc(b.t) + '</h3></div>' + body + (b.html ? '<div class="dt-md">' + dtRender(b.html, cx) + '</div>' : '') + foot(act);
      }
      if (s.t === 'kt') {
        var x = s.x, rr = st.r.tests[x.id], res = rr ? dtScoreT(x, rr.ans, null) : null, nd = need(s.lv), lanMax = +d.lan || 0, lan = rr ? rr.lan : 0;
        var hdr = '<div class="dt-vh"><small>' + esc(dtGanTxt(k, x)) + ' · ' + x.cau.length + ' câu' + (+x.tg ? ' · ' + x.tg + ' phút' : '') + ' · đạt từ ' + String(s.lv === 'khoa' ? d.hk.kt : d.hb.kt).replace('.', ',') + '/' + d.thang + '</small><h3>' + esc(x.ten) + '</h3></div>';
        if (res && !st.redo) return hdr + '<div class="dt-score ' + (res.wait ? 'wait' : res.pct >= nd ? 'ok' : 'bad') + '"><b>' + (res.wait ? 'Chờ chấm' : dtFmtS(k, res.pct)) + '</b><span>' + (res.wait ? 'Trắc nghiệm đạt ' + res.got + '/' + res.tot + ' điểm · câu tự luận chờ người quản lý chấm' : (res.pct >= nd ? 'Đạt' : 'Chưa đạt') + ' · ' + res.got + '/' + res.tot + ' điểm') + ' · lần ' + lan + (lanMax ? '/' + lanMax : '') + '</span></div>' + (d.dapan ? dtReview(x, rr.ans, null) : '<p class="dt-help">Đáp án không được hiển thị theo cài đặt khóa học.</p>') + foot((!res.wait && res.pct < nd && (!lanMax || lan < lanMax)) ? '<button class="btn" data-redo="1">Làm lại</button>' : '');
        var Q = x.cau.slice(); if (d.tron) Q.sort(function (a, b) { return (a.id + x.id).localeCompare(b.id + x.id) * (a.id.charCodeAt(0) % 2 ? 1 : -1); });
        return hdr + (+x.tg ? '<div class="dt-timer" id="dtTm"></div>' : '') + '<div class="dt-qz">' + Q.map(function (q, qi) {
          var a = st.ans[q.id];
          return '<div class="dt-qi"><div class="dt-qh"><b>Câu ' + (qi + 1) + '.</b> ' + esc(q.hoi) + ' <span class="faint">(' + (q.diem || 1) + ' điểm · ' + (q.loai === 'nhieu' ? 'chọn nhiều' : q.loai === 'mot' ? 'chọn 1' : 'tự luận') + ')</span></div>' +
            (q.loai === 'tl' ? '<textarea class="input" rows="3" data-ta="' + q.id + '" placeholder="Viết câu trả lời của bạn…">' + esc(a || '') + '</textarea>' : q.pa.map(function (p, j) { return '<label class="dt-opt"><input type="' + (q.loai === 'mot' ? 'radio' : 'checkbox') + '" name="pq' + q.id + '" data-qa="' + q.id + '" value="' + j + '"' + ((a || []).indexOf(j) >= 0 ? ' checked' : '') + '><span>' + String.fromCharCode(65 + j) + '. ' + esc(p) + '</span></label>'; }).join('')) + '</div>';
        }).join('') + '</div>' + foot('<button class="btn btn-primary" data-sub="' + x.id + '">Nộp bài</button>').replace(nextBtn(), '');
      }
      if (s.t === 'xn') return '<div class="dt-vh"><small>Bước cuối</small><h3>Xác nhận</h3></div><label class="dt-xn"><input type="checkbox" id="dtXn"' + (st.r.xn ? ' checked' : '') + '><span>' + esc(d.hk.xn.nd) + '</span></label>' + foot();
      var ev = dtEval(k, st.r), ok = ev.st === 'dat';
      return '<div class="dt-end">' + ic(ok ? 'dt_ok' : ev.st === 'cho' ? 'hn_clock' : 'info', 46) + '<h3>' + (ok ? 'Bạn đã hoàn thành khóa học' : ev.st === 'cho' ? 'Chờ chấm bài tự luận' : 'Chưa đủ điều kiện hoàn thành') + '</h3>' +
        '<ul class="dt-cond"><li class="' + (ev.prog >= d.hk.pct ? 'ok' : '') + '">Hoàn thành ' + ev.prog + '% bài học (cần ' + d.hk.pct + '%)</li>' + (dtTestsAt(k, 'khoa').length ? '<li class="' + (ev.fPct != null && ev.fPct >= need('khoa') ? 'ok' : '') + '">Bài kiểm tra cuối khóa: ' + (ev.fPct != null ? dtFmtS(k, ev.fPct) : 'chưa làm') + ' (cần ' + String(d.hk.kt).replace('.', ',') + '/' + d.thang + ')</li>' : '') + (d.hk.xn.on ? '<li class="' + (st.r.xn ? 'ok' : '') + '">Xác nhận cuối khóa</li>' : '') + '</ul>' +
        (demo ? '<p class="faint">Đây là bản xem thử – kết quả không được lưu.</p>' : '') + '<button class="btn btn-primary" data-close>Đóng</button></div>';
    }
    function draw() {
      clearInterval(st.timer);
      $('#dtView', m).innerHTML = viewHtml(); $('#dtNav', m).innerHTML = navHtml(); $('#dtView', m).scrollTop = 0;
      $$('[data-ta]', m).forEach(function (t) { t.addEventListener('input', function () { st.ans[t.getAttribute('data-ta')] = t.value; }); });
      $$('[data-qa]', m).forEach(function (c) { c.addEventListener('change', function () { var q = c.getAttribute('data-qa'); st.ans[q] = $$('[data-qa="' + q + '"]', m).filter(function (x) { return x.checked; }).map(function (x) { return +x.value; }); }); });
      var xn = $('#dtXn', m); if (xn) xn.addEventListener('change', function () { st.r.xn = xn.checked ? HR.isoToday() : ''; $('#dtNav', m).innerHTML = navHtml(); });
      var op = $('[data-open]', m); if (op) op.addEventListener('click', function () { var s = steps[st.i]; if (d.hb.link === 'mo') { mark(s.b); setTimeout(draw, 300); } });
      var vf = $('#dtVF', m); if (vf) vf.addEventListener('load', function () { try { vf.contentWindow.postMessage(/youtube/.test(vf.src) ? JSON.stringify({ event: 'listening', id: 1, channel: 'widget' }) : JSON.stringify({ method: 'addEventListener', value: 'timeupdate' }), '*'); } catch (e) { } });
      var tm = $('#dtTm', m), s = steps[st.i]; if (tm && s.t === 'kt') { var end = Date.now() + s.x.tg * 60000; var tick = function () { var r = Math.max(0, end - Date.now()), mm = Math.floor(r / 60000), ss = Math.floor(r % 60000 / 1000); tm.textContent = 'Còn ' + mm + ':' + p2(ss); if (!r) { clearInterval(st.timer); var b = $('[data-sub]', m); if (b) b.click(); } }; tick(); st.timer = setInterval(tick, 1000); }
    }
    // theo dõi % đã xem video (YouTube, Vimeo gửi tiến độ qua postMessage)
    function onMsg(ev) {
      var s = steps[st.i]; if (!s || s.t !== 'b' || s.b.loai !== 'video') return; var dd; try { dd = typeof ev.data === 'string' ? JSON.parse(ev.data) : ev.data; } catch (e) { return; }
      var p = null; if (dd && dd.event === 'infoDelivery' && dd.info && dd.info.currentTime != null && dd.info.duration) p = dd.info.currentTime / dd.info.duration; if (dd && dd.event === 'timeupdate' && dd.data && dd.data.percent != null) p = dd.data.percent;
      if (p == null) return; var b = s.b; st.vid[b.id] = Math.max(st.vid[b.id] || 0, p);
      var vp = $('#dtVP', m); if (vp) vp.innerHTML = '<span class="dt-bar"><i style="width:' + Math.round(st.vid[b.id] * 100) + '%"></i></span><small>Đã xem ' + Math.round(st.vid[b.id] * 100) + '% · cần ' + d.hb.vid + '%</small>';
      if (!done(b) && st.vid[b.id] * 100 >= (+d.hb.vid || 0)) { mark(b); $('#dtNav', m).innerHTML = navHtml(); toast('✓ Đã xem đủ ' + d.hb.vid + '% video – bài học hoàn thành', 'ok'); }
    }
    window.addEventListener('message', onMsg);
    m.addEventListener('click', function (ev) {
      var t = ev.target.closest('[data-ni],[data-go2],[data-sub],[data-redo],[data-mark]'); if (!t) return;
      if (t.hasAttribute('data-ni')) { st.i = +t.getAttribute('data-ni'); st.redo = false; }
      else if (t.hasAttribute('data-go2')) { st.i = +t.getAttribute('data-go2'); st.redo = false; }
      else if (t.hasAttribute('data-mark')) mark(steps[st.i].b);
      else if (t.hasAttribute('data-redo')) { st.redo = true; var x0 = steps[st.i].x; x0.cau.forEach(function (q) { delete st.ans[q.id]; }); }
      else if (t.hasAttribute('data-sub')) {
        var x = steps[st.i].x, miss = x.cau.filter(function (q) { var a = st.ans[q.id]; return q.loai === 'tl' ? !String(a || '').trim() : !(a || []).length; });
        if (miss.length && !(+x.tg && $('#dtTm', m) && /0:00$/.test($('#dtTm', m).textContent))) { toast('Còn ' + miss.length + ' câu chưa trả lời', 'info', 'Câu ' + miss.map(function (q) { return x.cau.indexOf(q) + 1; }).join(', ')); return; }
        var ans = {}; x.cau.forEach(function (q) { ans[q.id] = st.ans[q.id]; }); var old = st.r.tests[x.id], sc = dtScoreT(x, ans, null);
        var keep = old && d.lay === 'cao' && !sc.wait && old.pct > sc.pct; st.r.tests[x.id] = keep ? Object.assign(old, { lan: old.lan + 1 }) : { ans: ans, tl: {}, pct: sc.pct, lan: (old ? old.lan : 0) + 1, at: HR.isoToday() }; st.redo = false;
      }
      draw();
    });
    draw();
  }
  function dtReview(t, ans, tl) {
    return '<div class="dt-rv">' + (t.cau || []).map(function (q, qi) {
      var a = ans ? ans[q.id] : null;
      if (q.loai === 'tl') { var g = tl && tl[q.id]; return '<div class="dt-rvi"><b>Câu ' + (qi + 1) + '.</b> ' + esc(q.hoi) + '<div class="dt-rva">' + (a ? esc(a) : '<span class="faint">(chưa trả lời)</span>') + '</div>' + (g && g.d !== undefined && g.d !== '' ? '<small class="ok">Chấm ' + g.d + '/' + (q.diem || 1) + (g.nx ? ' · ' + esc(g.nx) : '') + '</small>' : '<small class="warn">Tự luận – chờ chấm</small>') + '</div>'; }
      var ok = (q.dung || []).slice().sort().join(',') === (a || []).slice().sort().join(',');
      return '<div class="dt-rvi ' + (ok ? 'ok' : 'bad') + '"><b>Câu ' + (qi + 1) + '.</b> ' + esc(q.hoi) + ' <span class="tag ' + (ok ? 'tag-ok' : 'tag-bad') + '">' + (ok ? 'Đúng' : 'Sai') + '</span><ul>' + q.pa.map(function (p, j) { var my = (a || []).indexOf(j) >= 0, cr = (q.dung || []).indexOf(j) >= 0; return '<li class="' + (cr ? 'cr' : '') + (my ? ' my' : '') + '">' + String.fromCharCode(65 + j) + '. ' + esc(p) + (my ? ' <em>(đã chọn)</em>' : '') + (cr ? ' ✓' : '') + '</li>'; }).join('') + '</ul></div>';
    }).join('') + '</div>';
  }

  /* ---------------- Trang Theo dõi học tập ---------------- */
  PAGES.dtketqua = function () {
    var f = ps('dtk', { co: '', pb: '', kh: '', st: '', q: '', view: 'list' }), R = refDate(), us = selUnits(), multi = us.length > 1;
    var base = dtRows(us, R).filter(function (x) { return (!f.co || x.u.id === f.co) && (!f.pb || (x.e['Phòng ban'] || '') === f.pb) && (!f.kh || x.k.id === f.kh); });
    var cnt = { all: base.length, dat: 0, hoc: 0, chua: 0, cho: 0, late: 0, khong: 0 }; base.forEach(function (x) { if (x.late) cnt.late++; if (x.st === 'dat') cnt.dat++; else if (x.st === 'cho') cnt.cho++; else if (x.st === 'hoc') cnt.hoc++; else if (x.st === 'khong' || x.st === 'lai') cnt.khong++; else cnt.chua++; });
    var q = norm(f.q || ''), rows = base.filter(function (x) {
