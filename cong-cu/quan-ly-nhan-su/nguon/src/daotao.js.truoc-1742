    var Fld = T.Node.create({
      name: 'dtField', group: 'inline', inline: true, atom: true, selectable: true, draggable: true,
      addAttributes: function () { return { k: { default: '', parseHTML: function (el) { return el.getAttribute('data-dtf'); }, renderHTML: function (a) { return { 'data-dtf': a.k }; } } }; },
      parseHTML: function () { return [{ tag: 'span[data-dtf]' }]; },
      renderHTML: function (p) { var k = p.node.attrs.k; return ['span', T.mergeAttributes(p.HTMLAttributes, { class: 'tpe-f dt-f' + (DT_FB[k] ? ' blk' : ''), title: 'Trường liên kết – bấm để xem giá trị mới nhất' }), (DT_FB[k] ? '▤ ' : '') + (DT_FL[k] || k)]; },
      renderText: function (p) { return '{{' + p.node.attrs.k + '}}'; }
    });
    DTX = { Fld: Fld }; return DTX;
  }
  function dtRteDestroy() { DT_ED.forEach(function (x) { try { x.ed.destroy(); } catch (e) { } }); DT_ED = []; dtPopClose(); }
  var DT_POP = null;
  function dtPopClose() { if (DT_POP) { DT_POP.remove(); DT_POP = null; document.removeEventListener('mousedown', dtPopOut, true); } }
  function dtPopOut(e) { if (DT_POP && !DT_POP.contains(e.target)) dtPopClose(); }
  function dtPopAt(el, html, cls) {
    dtPopClose(); var r = el.getBoundingClientRect(), p = document.createElement('div'); p.className = 'dt-pop ' + (cls || ''); p.innerHTML = html; document.body.appendChild(p);
    var w = p.offsetWidth, h = p.offsetHeight; p.style.left = Math.max(8, Math.min(r.left, window.innerWidth - w - 8)) + 'px'; p.style.top = (r.bottom + h + 8 > window.innerHeight ? Math.max(8, r.top - h - 6) : r.bottom + 6) + 'px';
    DT_POP = p; setTimeout(function () { document.addEventListener('mousedown', dtPopOut, true); }, 0); return p;
  }
  // Popup giá trị mới nhất của 1 trường (lấy với 1 người cụ thể – chọn được)
  function dtFieldPop(el, key, k) {
    var cx = dtCtx(k), us = S.units, opts = [];
    us.forEach(function (u) { var R = refDate(), mat = HR.maternitySet(u.data, R); (u.data.NV || []).forEach(function (x) { if (HR.staffState(x, R, mat) !== 'left') opts.push([u.id + '|' + x['Mã NV'], x['Họ và tên'] + (us.length > 1 ? ' · ' + shortUnit(u.name) : '')]); }); });
    function body() { var v = dtVal(key, cx); return '<div class="dt-pop-h"><b>' + esc(DT_FL[key] || key) + '</b><span class="faint">trường liên kết – luôn lấy dữ liệu mới nhất</span></div>' + (/^(ho_ten|ma_nv|chuc_danh|phong_ban|ngay_vao_lam|truong_bo_phan|phep_nam|gio_lam_viec)$/.test(key) ? '<label class="dt-pop-l">Xem với nhân sự <select class="input" id="dtFp">' + opts.map(function (o) { return '<option value="' + esc(o[0]) + '"' + (cx.e && o[0] === cx.u.id + '|' + cx.e['Mã NV'] ? ' selected' : '') + '>' + esc(o[1]) + '</option>'; }).join('') + '</select></label>' : '') + '<div class="dt-pop-v">' + (v ? (DT_FB[key] ? v : esc(v)) : '<span class="faint">(chưa có dữ liệu)</span>') + '</div><div class="dt-pop-f">' + dtFSrc(key) + '</div>'; }
    var p = dtPopAt(el, body(), 'fld');
    p.addEventListener('change', function (ev) { if (ev.target.id !== 'dtFp') return; var a = ev.target.value.split('|'), u = unitById(a[0]); cx = { k: k, u: u, e: nvIndex(u)[a[1]] }; p.innerHTML = body(); });
  }
  function dtFSrc(key) { var m = { phep_nam: 'Nghỉ phép → Quỹ phép', gio_lam_viec: 'Chấm công → Thiết lập chấm công', ngay_nghi_le: 'Chấm công → Thiết lập chung', so_do_to_chuc: 'Nhân sự → Sơ đồ tổ chức', truong_bo_phan: 'Cài đặt → Danh mục phòng ban', cong_ty: 'Hợp đồng → Thông tin công ty', dia_chi: 'Hợp đồng → Thông tin công ty', giam_doc: 'Hợp đồng → Thông tin công ty', ten_khoa: 'Thông tin khóa học', giang_vien: 'Thông tin khóa học', thoi_luong: 'Thông tin khóa học' }; return 'Nguồn: ' + (m[key] || 'Hồ sơ nhân sự'); }
  // Gắn khung soạn thảo vào 1 ô: host = phần tử, html ban đầu, onChange(html)
  function dtRte(host, html, onChange, k, ph) {
