    host.innerHTML = '<div class="tpe-bar dt-tb">' +
      '<div class="tpe-g">' + b('undo', ic('undo', 16), 'Hoàn tác (Ctrl+Z)') + b('redo', ic('redo', 16), 'Làm lại (Ctrl+Y)') + '</div>' +
      '<div class="tpe-g"><select class="tpe-s" data-s="blk" title="Kiểu đoạn"><option value="p">Đoạn văn</option><option value="h2">Tiêu đề</option><option value="h3">Tiêu đề nhỏ</option></select></div>' +
      '<div class="tpe-g">' + b('b', '<b>B</b>', 'In đậm (Ctrl+B)') + b('i', '<i>I</i>', 'In nghiêng (Ctrl+I)') + b('u', '<u>U</u>', 'Gạch chân (Ctrl+U)') + '</div>' +
      '<div class="tpe-g">' + b('ul', ic('ul', 16), 'Gạch đầu dòng') + b('ol', ic('ol', 16), 'Đánh số') + b('al-left', ic('alL', 16), 'Căn trái') + b('al-center', ic('alC', 16), 'Căn giữa') + b('al-justify', ic('alJ', 16), 'Căn đều') + '</div>' +
      '<div class="tpe-g">' + b('tbl', ic('tbl', 16) + '<span>Bảng</span>', 'Chèn bảng, thêm hàng / cột') + '</div>' +
      '<div class="tpe-g">' + b('fld', ic('fld', 16) + '<span>Trường liên kết</span>', 'Chèn thông tin đã có trên hệ thống – luôn hiện dữ liệu mới nhất') + '</div></div>' +
      '<div class="dt-rte-doc"></div>';
    var ed = new T.Editor({
      element: host.querySelector('.dt-rte-doc'),
      extensions: [T.Document, T.Paragraph, T.Text, T.Bold, T.Italic, T.Underline, T.Heading.configure({ levels: [2, 3] }), T.HardBreak, T.BulletList, T.OrderedList, T.ListItem, T.ListKeymap, T.Dropcursor.configure({ color: '#3F6B35', width: 2 }), T.Gapcursor, T.UndoRedo,
        T.TextAlign.configure({ types: ['heading', 'paragraph'], alignments: ['left', 'center', 'justify'] }), T.Table.configure({ resizable: false }), T.TableRow, T.TableHeader, T.TableCell, X.Fld, T.Placeholder.configure({ placeholder: ph || 'Gõ nội dung…' })],
      content: html || '', editorProps: { attributes: { class: 'dt-rte-pm', spellcheck: 'false' } }
    });
    DT_ED.push({ ed: ed, host: host });
    function sync() {
      var set = function (c, on) { var x = host.querySelector('[data-c="' + c + '"]'); if (x) x.classList.toggle('on', !!on); };
      set('b', ed.isActive('bold')); set('i', ed.isActive('italic')); set('u', ed.isActive('underline')); set('ul', ed.isActive('bulletList')); set('ol', ed.isActive('orderedList'));
      var al = ed.getAttributes(ed.isActive('heading') ? 'heading' : 'paragraph').textAlign || 'left'; ['left', 'center', 'justify'].forEach(function (x) { set('al-' + x, al === x); });
      host.querySelector('[data-s="blk"]').value = ed.isActive('heading', { level: 2 }) ? 'h2' : ed.isActive('heading', { level: 3 }) ? 'h3' : 'p';
      host.querySelector('[data-c="undo"]').disabled = !ed.can().undo(); host.querySelector('[data-c="redo"]').disabled = !ed.can().redo();
    }
    ed.on('transaction', sync); ed.on('update', function () { onChange(ed.isEmpty ? '' : ed.getHTML()); }); sync();
    host.querySelector('[data-s="blk"]').addEventListener('change', function (e) { var v = e.target.value, c = ed.chain().focus(); (v === 'p' ? c.setParagraph() : c.setHeading({ level: +v.slice(1) })).run(); });
    host.querySelector('.dt-tb').addEventListener('mousedown', function (e) { if (e.target.closest('button')) e.preventDefault(); });
    host.querySelector('.dt-tb').addEventListener('click', function (e) {
      var x = e.target.closest('[data-c]'); if (!x) return; var c = x.getAttribute('data-c'), ch = ed.chain().focus();
      if (c === 'undo') ch.undo().run(); else if (c === 'redo') ch.redo().run(); else if (c === 'b') ch.toggleBold().run(); else if (c === 'i') ch.toggleItalic().run(); else if (c === 'u') ch.toggleUnderline().run();
      else if (c === 'ul') ch.toggleBulletList().run(); else if (c === 'ol') ch.toggleOrderedList().run(); else if (/^al-/.test(c)) ch.setTextAlign(c.slice(3)).run();
      else if (c === 'tbl') {
        var M = [['ins', 'Chèn bảng 3 × 3 có hàng tiêu đề'], ['addRowAfter', 'Thêm hàng phía dưới'], ['addColumnAfter', 'Thêm cột bên phải'], ['deleteRow', 'Xóa hàng'], ['deleteColumn', 'Xóa cột'], ['deleteTable', 'Xóa bảng']];
        var p = dtPopAt(x, '<div class="dt-pop-list">' + M.map(function (m) { return '<button type="button" data-t="' + m[0] + '">' + m[1] + '</button>'; }).join('') + '</div>', 'menu');
        p.addEventListener('mousedown', function (ev) { var t = ev.target.closest('[data-t]'); if (!t) return; ev.preventDefault(); var a = t.getAttribute('data-t'), cc = ed.chain().focus(); (a === 'ins' ? cc.insertTable({ rows: 3, cols: 3, withHeaderRow: true }) : cc[a]()).run(); dtPopClose(); });
      } else if (c === 'fld') {
        var p2 = dtPopAt(x, '<div class="dt-pop-h"><b>Trường liên kết</b><span class="faint">bấm để chèn tại con trỏ · trên bài học tự hiện dữ liệu mới nhất</span></div><div class="dt-pop-list">' + DT_F.map(function (g) { return '<div class="dt-pop-g">' + esc(g[0]) + '</div>' + g[1].map(function (f) { return '<button type="button" data-f="' + f[0] + '">' + (f[2] ? '▤ ' : '') + esc(f[1]) + '<small>' + esc(dtShort(dtVal(f[0], dtCtx(k)))) + '</small></button>'; }).join(''); }).join('') + '</div>', 'menu wide');
        p2.addEventListener('mousedown', function (ev) { var t = ev.target.closest('[data-f]'); if (!t) return; ev.preventDefault(); ed.chain().focus().insertContent({ type: 'dtField', attrs: { k: t.getAttribute('data-f') } }).insertContent(' ').run(); dtPopClose(); });
      }
    });
    host.querySelector('.dt-rte-doc').addEventListener('click', function (e) { var f = e.target.closest('[data-dtf]'); if (f) dtFieldPop(f, f.getAttribute('data-dtf'), k); });
    return ed;
  }
  function dtShort(v) { var t = String(v || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim(); return t ? (t.length > 46 ? t.slice(0, 45) + '…' : t) : '(chưa có dữ liệu)'; }

  /* ---------------- Dữ liệu mẫu ---------------- */
  function dtQ(id, loai, hoi, pa, dung, diem, gy) { return loai === 'tl' ? { id: id, loai: 'tl', hoi: hoi, goi_y: gy || '', diem: diem || 2 } : { id: id, loai: loai, hoi: hoi, pa: pa, dung: dung, diem: diem || 1 }; }
  function dtSample(withSamples) {
    var F = function (k) { return '<span data-dtf="' + k + '">' + esc(DT_FL[k]) + '</span>'; };
    // 12/11 16:30 anh: khóa Hội nhập mẫu hoàn chỉnh để demo – nội dung chi tiết, bài kiểm tra cuối khóa 20 câu, ảnh bìa
    var P = function (t) { return '<p>' + t + '</p>'; }, UL = function (a) { return '<ul>' + a.map(function (x) { return '<li><p>' + x + '</p></li>'; }).join('') + '</ul>'; }, OL = function (a) { return '<ol>' + a.map(function (x) { return '<li><p>' + x + '</p></li>'; }).join('') + '</ol>'; };
    var TB = function (h, rows) { return '<table><tbody><tr>' + h.map(function (x) { return '<th><p>' + x + '</p></th>'; }).join('') + '</tr>' + rows.map(function (r) { return '<tr>' + r.map(function (x) { return '<td><p>' + x + '</p></td>'; }).join('') + '</tr>'; }).join('') + '</tbody></table>'; };
    var hn = {
      id: 'KH01', mau: 1, hn: 1, ten: 'Hội nhập: Bắt đầu hành trình cùng công ty', tl: { n: 90, dv: 'phut' }, gv: 'Phòng Hành chính – Nhân sự', dt: 'Nhân viên mới, học trong 7 ngày đầu đi làm', bia: typeof DT_BIA_HN === 'string' ? DT_BIA_HN : '', vid: '', mau_c: DT_COL[0],
      gt: '<p>Chào mừng bạn đến với công ty! Khóa học này giúp bạn <strong>hiểu công ty, nắm nội quy, quyền lợi và tự tin làm việc ngay từ tuần đầu tiên</strong> – thay cho việc phải hỏi từng người hay đọc một tập tài liệu dày.</p><p>Bạn học trên điện thoại, lúc nào rảnh cũng được, mỗi bài khoảng 5 phút. Thông tin trong bài (phòng ban, người phụ trách, giờ làm, ngày phép của bạn…) phần mềm tự lấy từ hồ sơ của bạn nên luôn đúng và mới nhất.</p><h3>Khóa học gồm</h3>' + UL(['<strong>Chương 1</strong> – Công ty mình là ai: câu chuyện, giá trị, các bộ phận', '<strong>Chương 2</strong> – Một ngày làm việc: giờ làm, chấm công, nghỉ phép, dùng app', '<strong>Chương 3</strong> – Nội quy và văn hóa: những điều cần nhớ, bảo mật thông tin, cách ứng xử', '<strong>Chương 4</strong> – Quyền lợi và phát triển: lương, bảo hiểm, thử việc, lộ trình']) + '<p>Cuối khóa có bài kiểm tra 20 câu và xác nhận đã đọc nội quy.</p>',
      lt: ['Biết công ty làm gì, giá trị cốt lõi và ai phụ trách bộ phận nào', 'Tự chấm công, xin nghỉ, xem phiếu lương trên app – không cần hỏi ai', 'Nắm 10 điểm chính của nội quy và cách giữ an toàn thông tin', 'Hiểu quyền lợi: lương, phép năm, bảo hiểm, đánh giá thử việc', 'Biết gặp vướng mắc thì hỏi ai, ở đâu', 'Tự tin bắt nhịp công việc ngay trong tuần đầu'],
      hp: { loai: 'free', so: 0 },
      ch: [
        { id: 'c1', t: 'Công ty mình là ai', mo: 'Câu chuyện, giá trị cốt lõi và các bộ phận trong công ty.', bai: [
          { id: 'b1', loai: 'doc', t: 'Thư chào mừng', ph: 5, html: '<h2>Chào mừng ' + F('ho_ten') + ' đến với ' + F('cong_ty') + '!</h2>' + P('Thay mặt toàn thể anh chị em trong công ty, chúng tôi rất vui khi bạn chọn đồng hành cùng chúng tôi. Những ngày đầu ở một nơi mới luôn có nhiều bỡ ngỡ – khóa học này được làm ra để bạn không phải đi hỏi từng người.') + '<h3>Thông tin của bạn</h3>' + TB(['Mục', 'Thông tin'], [['Vị trí', F('chuc_danh')], ['Phòng ban', F('phong_ban')], ['Người phụ trách trực tiếp', F('truong_bo_phan')], ['Ngày vào làm', F('ngay_vao_lam')]]) + '<h3>Trong 7 ngày đầu, bạn sẽ</h3>' + OL(['Hoàn thành khóa học này trên app (khoảng 90 phút, chia nhỏ theo bài)', 'Ký hợp đồng thử việc, nộp đủ giấy tờ theo danh sách phòng nhân sự gửi', 'Gặp người đồng hành – người sẽ hướng dẫn bạn trong thời gian thử việc', 'Trao đổi với trưởng bộ phận về mục tiêu công việc tháng đầu tiên']) + P('<em>Có bất cứ điều gì chưa rõ, bạn cứ hỏi – không có câu hỏi nào là "ngớ ngẩn" ở đây.</em>') + P('Thân mến,<br><strong>' + F('giam_doc') + '</strong>') },
          { id: 'b2', loai: 'video', t: 'Video: Một ngày ở công ty', ph: 5, url: '', html: P('Video ngắn giới thiệu văn phòng, xưởng và những gương mặt bạn sẽ gặp hằng ngày.') + P('<em>Phòng nhân sự dán link video (YouTube, Google Drive…) ở Kho khóa học → Sửa → Bài giảng.</em>') },
          { id: 'b3', loai: 'doc', t: 'Câu chuyện và giá trị cốt lõi', ph: 7, html: '<h2>Câu chuyện của chúng tôi</h2>' + P(F('cong_ty') + ' được thành lập bởi những người tin rằng một doanh nghiệp nhỏ vẫn có thể làm việc bài bản, minh bạch và đối xử tử tế với từng người. Hôm nay công ty có ' + F('so_nhan_su') + ' – mỗi người đều được biết rõ việc của mình và được ghi nhận công bằng.') + '<h2>Sứ mệnh</h2>' + P('Mang đến sản phẩm, dịch vụ chất lượng thật, giá trị thật cho khách hàng – và một nơi làm việc mà mọi người muốn gắn bó lâu dài.') + '<h2>4 giá trị cốt lõi</h2>' + TB(['Giá trị', 'Ở đây nghĩa là'], [['<strong>Tử tế</strong>', 'Nói thật, làm thật; tôn trọng khách hàng và đồng nghiệp như cách mình muốn được đối xử'], ['<strong>Chủ động</strong>', 'Thấy việc thì làm, thấy vướng thì báo sớm – không chờ được giao từng việc nhỏ'], ['<strong>Học hỏi</strong>', 'Mỗi tuần tốt hơn một chút; sai thì sửa, không giấu'], ['<strong>Trách nhiệm</strong>', 'Nhận việc nào làm đến nơi đến chốn việc đó, đúng hạn, đúng cam kết']]) },
          { id: 'b4', loai: 'doc', t: 'Sơ đồ tổ chức – ai làm gì', ph: 5, html: '<h2>Các bộ phận trong công ty</h2>' + P('Danh sách dưới đây phần mềm tự lấy từ Sơ đồ tổ chức – luôn đúng với hiện tại:') + '<p>' + F('so_do_to_chuc') + '</p><h3>Bạn thuộc</h3>' + P(F('phong_ban') + ' – người phụ trách: ' + F('truong_bo_phan') + '.') + '<h3>Cần hỏi gì?</h3>' + UL(['Việc chuyên môn, kế hoạch công việc: <strong>trưởng bộ phận</strong> hoặc <strong>người đồng hành</strong> của bạn', 'Hồ sơ, hợp đồng, bảo hiểm, nghỉ phép: <strong>phòng nhân sự</strong>', 'Lương, phiếu lương, tạm ứng: <strong>kế toán</strong>', 'Máy tính, tài khoản, app nhân viên: người <strong>phụ trách thiết bị, tài khoản</strong>']) }
        ] },
        { id: 'c2', t: 'Một ngày làm việc', mo: 'Giờ làm, chấm công, nghỉ phép và cách dùng app nhân viên.', bai: [
          { id: 'b5', loai: 'doc', t: 'Giờ làm việc và chấm công', ph: 6, html: '<h2>Giờ làm việc của bạn</h2>' + P('Theo ca của phòng ban: <strong>' + F('gio_lam_viec') + '</strong>.') + UL(['Có mặt trước giờ vào ca 5–10 phút để chuẩn bị', 'Nghỉ trưa theo giờ chung của bộ phận', 'Làm thêm giờ chỉ tính khi được trưởng bộ phận đồng ý trước']) + '<h2>Chấm công trên app – 3 bước</h2>' + OL(['Kết nối Wi‑Fi văn phòng (hoặc quét mã QR ở quầy lễ tân nếu mạng chập chờn)', 'Mở app → bấm <strong>Chấm vào ca</strong> khi đến, <strong>Chấm ra ca</strong> khi về', 'Kiểm tra giờ vừa chấm hiện ở mục <strong>Chấm công hôm nay</strong>']) + '<h3>Quên chấm hoặc chấm sai?</h3>' + P('Vào mục <strong>Công</strong> → chọn ngày → <strong>Báo sai</strong>, ghi rõ giờ thực tế. Gửi <strong>ngay trong ngày</strong> để kế toán kịp kiểm tra. Cuối tháng bạn sẽ nhận bảng công để <strong>xác nhận</strong> trước khi tính lương.') },
          { id: 'b6', loai: 'doc', t: 'Nghỉ phép và đơn từ', ph: 6, html: '<h2>Phép năm của bạn</h2>' + P(F('phep_nam') + '. Số ngày còn lại luôn hiện ở mục <strong>Bạn</strong> trên app.') + P('Theo Bộ luật Lao động 2019 (Điều 113), người làm đủ 12 tháng trong điều kiện bình thường có 12 ngày phép năm hưởng nguyên lương; làm chưa đủ 12 tháng thì tính theo tỷ lệ số tháng làm việc. Cứ đủ 5 năm làm việc được thêm 1 ngày (Điều 114).') + '<h2>Cách xin nghỉ</h2>' + OL(['Mở app → mục <strong>Đơn</strong> → <strong>Tạo đơn nghỉ</strong>', 'Chọn loại nghỉ, ngày nghỉ, ghi lý do và người bàn giao công việc', 'Gửi trước ít nhất <strong>1 ngày</strong> (nghỉ đột xuất: báo trưởng bộ phận rồi bổ sung đơn trong ngày)', 'Trưởng bộ phận duyệt trên app – bạn nhận thông báo ngay']) + '<h2>Các ngày nghỉ lễ năm nay</h2><p>' + F('ngay_nghi_le') + '</p>' },
          { id: 'b7', loai: 'doc', t: 'Dùng app nhân viên', ph: 6, html: '<h2>Mọi việc hành chính trong một app</h2>' + TB(['Mục trên app', 'Bạn làm được'], [['Trang chủ', 'Chấm công vào, ra; xem việc cần làm; học các khóa đào tạo'], ['Công', 'Xem công từng ngày, báo sai, xác nhận bảng công cuối tháng'], ['Đơn', 'Tạo đơn nghỉ, theo dõi đơn đã duyệt; trưởng bộ phận duyệt đơn của nhân viên'], ['Lương', 'Xem phiếu lương từng tháng, biến động thu nhập cả năm'], ['Bạn', 'Hồ sơ cá nhân, hợp đồng, sơ đồ tổ chức, đổi mã PIN']]) + '<h3>Đăng nhập an toàn</h3>' + UL(['Tài khoản là <strong>mã nhân viên</strong> của bạn: ' + F('ma_nv'), 'Lần đầu đăng nhập, vào <strong>Bạn → Đổi mã PIN</strong> để đặt mã của riêng bạn', 'Không cho người khác mượn điện thoại để chấm công hộ – phần mềm tự phát hiện một máy chấm cho nhiều người']) }
        ] },
        { id: 'c3', t: 'Nội quy và văn hóa', mo: 'Những điều cần nhớ, bảo mật thông tin và cách ứng xử.', bai: [
          { id: 'b8', loai: 'doc', t: 'Nội quy lao động – 10 điều cần nhớ', ph: 8, html: '<h2>10 điều cần nhớ</h2>' + OL(['Đi làm đúng giờ; đi muộn, về sớm phải báo trưởng bộ phận trước', 'Chấm công đúng thực tế; không chấm hộ, không nhờ chấm hộ', 'Nghỉ phải có đơn được duyệt (trừ trường hợp khẩn cấp, bổ sung sau)', 'Trang phục gọn gàng, phù hợp công việc; đeo thẻ nhân viên trong giờ làm', 'Giữ bí mật thông tin khách hàng, học viên và dữ liệu của công ty', 'Bảo quản tài sản, thiết bị được giao; làm hỏng, mất phải báo ngay', 'Không hút thuốc, uống rượu bia trong giờ làm và khu vực làm việc', 'Ứng xử lịch sự, tôn trọng; không quấy rối, phân biệt đối xử dưới mọi hình thức', 'Tuân thủ quy định an toàn, vệ sinh tại nơi làm việc', 'Vướng mắc về công việc, quyền lợi – trao đổi trực tiếp, không để bức xúc kéo dài']) + P('<em>Đây là bản tóm tắt. Bản nội quy đầy đủ đã đăng ký theo quy định ở bài tiếp theo – nội quy đầy đủ mới là căn cứ khi xử lý kỷ luật.</em>') },
          { id: 'b9', loai: 'link', t: 'Nội quy lao động (bản đầy đủ)', ph: 10, url: '', html: P('Đọc kỹ bản đầy đủ – cuối khóa bạn sẽ xác nhận đã đọc và cam kết thực hiện.') + P('<em>Phòng nhân sự dán link file nội quy (Google Drive, OneDrive…) ở Kho khóa học → Sửa → Bài giảng.</em>') },
          { id: 'b10', loai: 'doc', t: 'Bảo mật thông tin và dữ liệu cá nhân', ph: 6, html: '<h2>Thông tin nào cần giữ kín?</h2>' + UL(['Họ tên, số điện thoại, địa chỉ, giấy tờ của khách hàng, học viên', 'Hồ sơ, lương, đánh giá của đồng nghiệp', 'Giá vốn, hợp đồng, kế hoạch kinh doanh của công ty']) + P('Dữ liệu cá nhân được pháp luật bảo vệ – làm lộ có thể gây thiệt hại cho người khác và rủi ro pháp lý cho công ty.') + '<h2>5 thói quen nhỏ</h2>' + OL(['Khóa màn hình khi rời chỗ (Windows + L)', 'Không gửi danh sách khách hàng qua nhóm chat cá nhân hoặc email riêng', 'Không dùng chung mật khẩu, mã PIN; đổi ngay nếu nghi bị lộ', 'Kiểm tra kỹ người nhận trước khi gửi file', 'Thấy dấu hiệu lộ dữ liệu: báo ngay trưởng bộ phận – báo sớm không bị phạt']) },
          { id: 'b11', loai: 'doc', t: 'Văn hóa làm việc', ph: 5, html: '<h2>Ở đây chúng tôi làm việc thế này</h2>' + TB(['Nên', 'Tránh'], [['Hỏi khi chưa rõ, xác nhận lại việc được giao', 'Đoán ý rồi làm sai mất thời gian cả nhóm'], ['Báo sớm khi có nguy cơ trễ hạn', 'Im lặng đến hạn mới báo không kịp'], ['Góp ý thẳng thắn, đúng việc, tôn trọng người', 'Nói sau lưng, đổ lỗi'], ['Ghi nhận và cảm ơn khi được giúp đỡ', 'Coi sự giúp đỡ là đương nhiên']]) + '<h3>Họp nhanh đầu tuần</h3>' + P('Sáng thứ Hai, mỗi bộ phận họp 15 phút: việc tuần trước, việc tuần này, ai cần hỗ trợ gì. Người mới được giới thiệu ở buổi họp đầu tiên.') }
        ] },
        { id: 'c4', t: 'Quyền lợi và phát triển', mo: 'Lương, bảo hiểm, thử việc và lộ trình phát triển.', bai: [
          { id: 'b12', loai: 'doc', t: 'Lương, thưởng và phiếu lương', ph: 6, html: '<h2>Lương được tính thế nào?</h2>' + UL(['<strong>Lương cơ bản</strong> theo hợp đồng – là căn cứ đóng bảo hiểm xã hội', '<strong>Phụ cấp</strong> (ăn ca, điện thoại, đi lại…) theo quy chế và ngày công thực tế', '<strong>Lương hiệu suất</strong> theo kết quả công việc tháng (nếu vị trí có áp dụng)', 'Trừ các khoản bảo hiểm phần người lao động đóng và thuế thu nhập cá nhân (nếu có)']) + '<h2>Lịch trả lương</h2>' + OL(['Đầu tháng: bạn xác nhận bảng công tháng trước trên app', 'Kế toán lập bảng lương, gửi phiếu lương lên app', 'Bạn xem phiếu, có thắc mắc thì phản hồi trong <strong>3 ngày</strong>', 'Lương chuyển khoản vào tài khoản ngân hàng đã đăng ký']) },
          { id: 'b13', loai: 'doc', t: 'Bảo hiểm và phúc lợi', ph: 5, html: '<h2>Bảo hiểm bắt buộc</h2>' + P('Khi ký hợp đồng lao động từ đủ 1 tháng trở lên, bạn được công ty đăng ký <strong>bảo hiểm xã hội, bảo hiểm y tế, bảo hiểm thất nghiệp</strong> theo quy định. Phần công ty đóng và phần bạn đóng đều thể hiện trên phiếu lương.') + '<h2>Phúc lợi của công ty</h2>' + UL(['Nghỉ lễ, Tết theo quy định; quà dịp lễ, Tết', 'Sinh nhật, hiếu hỉ có quà và thăm hỏi', 'Khám sức khỏe định kỳ hằng năm', 'Các khóa đào tạo nội bộ miễn phí trên app']) + P('<em>Chi tiết từng khoản theo Quy chế lương, thưởng, phúc lợi của công ty.</em>') },
          { id: 'b14', loai: 'doc', t: 'Thử việc và đánh giá', ph: 6, html: '<h2>Thời gian thử việc</h2>' + P('Thời gian thử việc ghi trong hợp đồng thử việc của bạn, tối đa theo Bộ luật Lao động 2019 (Điều 25): 180 ngày với người quản lý doanh nghiệp; 60 ngày với vị trí cần trình độ cao đẳng trở lên; 30 ngày với trung cấp, công nhân kỹ thuật, nhân viên nghiệp vụ; 6 ngày làm việc với công việc khác. Lương thử việc ít nhất bằng 85% lương chính thức (Điều 26).') + '<h2>Được đánh giá thế nào?</h2>' + TB(['Mốc', 'Việc diễn ra'], [['Cuối tuần 1', 'Trao đổi nhanh với người đồng hành: đã quen việc chưa, cần hỗ trợ gì'], ['Giữa thử việc', 'Trưởng bộ phận góp ý tiến độ, điều chỉnh mục tiêu nếu cần'], ['Kết thúc thử việc', 'Đánh giá theo mục tiêu đã thống nhất, thông báo kết quả; đạt thì ký hợp đồng lao động']]) },
          { id: 'b15', loai: 'doc', t: 'Lộ trình phát triển và hỏi ai', ph: 5, html: '<h2>Phát triển cùng công ty</h2>' + UL(['Mỗi năm được đánh giá, xem xét điều chỉnh lương theo kết quả', 'Học thêm các khóa nội bộ trên app phù hợp vị trí', 'Có thể đề xuất chuyển vị trí, nhận việc mới khi đã sẵn sàng']) + '<h2>Gặp vướng mắc – hỏi ai?</h2>' + TB(['Vấn đề', 'Người hỗ trợ'], [['Công việc chuyên môn', F('truong_bo_phan')], ['Hồ sơ, hợp đồng, bảo hiểm, nghỉ phép', 'Phòng nhân sự'], ['Lương, phiếu lương', 'Kế toán'], ['Góp ý, đề xuất', 'Trực tiếp ' + F('giam_doc') + ' hoặc hộp thư góp ý']]) + P('<strong>Chúc bạn có những ngày đầu thật vui!</strong> Làm bài kiểm tra cuối khóa để hoàn thành nhé.') }
        ] }
      ],
      tests: [
        { id: 't1', ten: 'Kiểm tra nhanh: một ngày làm việc', gan: { l: 'chuong', id: 'c2' }, tg: 0, cau: [
          dtQ('q1', 'mot', 'Quên chấm công ra ca hôm nay, bạn làm gì?', ['Không cần làm gì, cuối tháng kế toán tự sửa', 'Vào mục Công → chọn ngày → Báo sai, ghi giờ thực tế trong ngày', 'Nhờ đồng nghiệp chấm hộ vào hôm sau'], [1]),
          dtQ('q2', 'nhieu', 'Những việc nào bạn làm được trên app nhân viên? (chọn tất cả ý đúng)', ['Chấm công vào, ra', 'Tạo đơn xin nghỉ', 'Xem phiếu lương', 'Tự sửa số tiền trên phiếu lương'], [0, 1, 2], 2),
          dtQ('q3', 'mot', 'Xin nghỉ phép thông thường cần gửi đơn trước ít nhất bao lâu?', ['1 ngày', '1 giờ', 'Không cần gửi đơn'], [0]),
          dtQ('q4', 'mot', 'Lần đầu đăng nhập app, bạn nên làm gì?', ['Chia sẻ mã PIN cho người đồng hành', 'Vào Bạn → Đổi mã PIN để đặt mã của riêng mình', 'Không cần làm gì'], [1]),
          dtQ('q5', 'mot', 'Làm thêm giờ được tính khi nào?', ['Khi tự ở lại làm', 'Khi được trưởng bộ phận đồng ý trước', 'Khi đến sớm hơn giờ vào ca'], [1])
        ] },
        { id: 't2', ten: 'Bài kiểm tra cuối khóa', gan: { l: 'khoa', id: '' }, tg: 30, cau: [
          dtQ('f1', 'mot', 'Giá trị cốt lõi "Chủ động" ở công ty nghĩa là gì?', ['Chỉ làm khi được giao từng việc', 'Thấy việc thì làm, thấy vướng thì báo sớm', 'Tự quyết mọi việc không cần trao đổi'], [1]),
          dtQ('f2', 'mot', 'Thông tin phòng ban, người phụ trách trong khóa học lấy từ đâu?', ['Phòng nhân sự gõ tay cho từng người', 'Phần mềm tự lấy từ hồ sơ và sơ đồ tổ chức, luôn mới nhất', 'Do bạn tự nhập'], [1]),
