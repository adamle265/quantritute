      '.dt-cmeta{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:12.5px;color:var(--ink-2)}.dt-cmeta span{display:inline-flex;gap:5px;align-items:center}.dt-cmeta svg{color:var(--dc)}.dt-cfor{font-size:12.5px;color:var(--muted)}.dt-cfor b{color:var(--ink-2);font-weight:600}',
