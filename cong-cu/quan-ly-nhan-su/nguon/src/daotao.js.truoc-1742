    }).join('') + '<div class="link-row" style="justify-content:flex-end"><button class="btn" data-close>Hủy</button><button class="btn btn-primary" id="dtChOk">Lưu điểm</button></div>');
    function tmp(box, t) { var tl = {}; t.cau.forEach(function (q) { if (q.loai !== 'tl') return; var v = $('[data-cd="' + q.id + '"]', box).value; tl[q.id] = { d: v === '' ? '' : Math.min(+q.diem || 1, Math.max(0, +v)), nx: $('[data-cn="' + q.id + '"]', box).value.trim() }; }); return tl; }
    function sum() { $$('.dt-chT', m).forEach(function (box) { var t = k.tests.filter(function (y) { return y.id === box.getAttribute('data-t'); })[0], s = dtScoreT(t, T[t.id].ans, tmp(box, t)), nd = dtNeed(k, t.gan.l === 'khoa' ? k.cd.hk.kt : k.cd.hb.kt); $('.dt-chsum', box).innerHTML = s.wait ? 'Còn câu chưa chấm' : 'Tổng: <b>' + s.got + '/' + s.tot + '</b> điểm = <b>' + dtFmtS(k, s.pct) + '</b> → <span class="tag ' + (s.pct >= nd ? 'tag-ok">Đạt' : 'tag-bad">Chưa đạt') + '</span>'; }); }
    $$('[data-cd]', m).forEach(function (i) { i.addEventListener('input', sum); }); sum();
    $('#dtChOk', m).addEventListener('click', function () {
