  function dtFVals(cx) { var o = {}; Object.keys(DT_FL).forEach(function (key) { if (key === 'ten_khoa' || key === 'giang_vien' || key === 'thoi_luong') return; o[key] = dtVal(key, cx); }); return o; }
  function dtAppPayload(u, ma) {
    var e = nvIndex(u)[ma]; if (!e) return null; var R = refDate(), L = [];
    dtKh().forEach(function (k) {
      if (!k.cd.on || !dtApplies(k, u, e)) return; var x = dtRow(u, e, k, R), r = x.r || {}, T = {};
      Object.keys(r.tests || {}).forEach(function (tid) { var t = k.tests.filter(function (y) { return y.id === tid; })[0], tr = r.tests[tid]; if (!t || !tr.ans) return; var s = dtScoreT(t, tr.ans, tr.tl); T[tid] = { pct: s.pct, wait: s.wait ? 1 : 0, lan: tr.lan || 1, at: tr.at || '', nx: Object.keys(tr.tl || {}).map(function (q) { return tr.tl[q].nx; }).filter(Boolean).join(' · ') }; });
      L.push(Object.assign(JSON.parse(JSON.stringify(k)), { due: x.due || '', kq: { st: x.st, tests: T, tay: r.tay ? 1 : 0, xn: r.xn || '', xong: r.xong || '', bai: r.bai || [] } }));
    });
    return L.length ? { v: 1, f: dtFVals({ u: u, e: e }), kh: L } : null;
  }
  window.dtAppPayload = dtAppPayload;
  // dữ liệu mẫu cho máy chủ bản thử (cham-cong-thu/src/demo-daotao.js): khóa học 1 lần + giao cho từng người
  window.dtDemoExport = function () {
    var o = { kh: {}, nv: {} }, R = refDate();
    S.units.filter(function (u) { return u.source === 'sample'; }).forEach(function (u) {
      var mat = HR.maternitySet(u.data, R);
      (u.data.NV || []).forEach(function (e) {
        if (!e['Mã NV'] || HR.staffState(e, R, mat) === 'left') return; var G = [];
        dtKh().forEach(function (k) { if (!k.cd.on || !dtApplies(k, u, e)) return; o.kh[k.id] = k; var x = dtRow(u, e, k, R); G.push({ id: k.id, due: x.due || '' }); });
        if (G.length) o.nv[e['Mã NV']] = { f: dtFVals({ u: u, e: e }), giao: G };
      });
    });
    return o;
  };
  // Kết quả học trên app → phần mềm
  function dtMerge(u, rows) {
    var kq = dtOf(u).kq, n = 0, nv = nvIndex(u);
    (rows || []).forEach(function (row) {
      var k = dtById(row.kh), d; if (!k || !nv[row.ma]) return; try { d = typeof row.du_lieu === 'string' ? JSON.parse(row.du_lieu) : row.du_lieu; } catch (e) { return; } if (!d) return;
      var r = (kq[row.ma] = kq[row.ma] || {})[k.id], old = JSON.stringify(r || null);
      if (r && r.tay) return;
      r = r || { bd: d.bd || '', bai: [], tests: {} }; r.tests = r.tests || {}; r.bai = r.bai || [];
      (d.bai || []).forEach(function (b) { if (r.bai.indexOf(b) < 0) r.bai.push(b); });
      Object.keys(d.tests || {}).forEach(function (tid) { var a = d.tests[tid], l = r.tests[tid]; var same = l && JSON.stringify(l.ans) === JSON.stringify(a.ans); r.tests[tid] = { ans: a.ans, tl: same ? l.tl || {} : {}, pct: a.pct, lan: a.lan || 1, at: a.at || '', app: 1 }; });
      if (d.xn && !r.xn) r.xn = d.xn; if (!r.bd && d.bd) r.bd = d.bd; r.app = row.at || 1;
      var ev = dtEval(k, r); if (ev.st === 'dat' && !r.xong) r.xong = d.xong || HR.isoToday();
      kq[row.ma][k.id] = r; if (JSON.stringify(r) !== old) n++;
    });
    return n;
  }
  // Khóa Hội nhập hoàn thành → bước tự học của người mới trong hành trình hội nhập tự xong
  function dtHnApply(u) {
    if (typeof hnOf !== 'function') return 0; var n = 0, R = refDate();
    dtKh().filter(function (k) { return k.hn && k.cd.on; }).forEach(function (k) {
      hnOf(u).ob.forEach(function (o) {
        if (o.st !== 'run' || !o.nv) return; var e = nvIndex(u)[o.nv]; if (!e) return;
        if (dtRow(u, e, k, R).st !== 'dat') return;
        o.steps.forEach(function (s) { if (s.x !== 'done' && s.own === 'nv' && /khóa đào tạo nội bộ|tìm hiểu công ty/i.test((s.title || '') + ' ' + (s.desc || ''))) { s.x = 'done'; s.dAt = HR.isoToday(); s.note = s.note || 'Hoàn thành khóa "' + k.ten + '" trên app'; n++; } });
      });
    });
    if (n && typeof hnSave === 'function') hnSave('Đánh dấu ' + n + ' bước hội nhập: người mới đã hoàn thành khóa học trên app');
    return n;
  }
  var DT_APP_AT = 0;
  function dtAppSync(force) {
    if (!force && Date.now() - DT_APP_AT < 45e3) return; DT_APP_AT = Date.now();
    var P = [];
    selUnits().forEach(function (u) {
      var real = typeof wfOn === 'function' && wfOn(u), demo = !real && u.source === 'sample' && typeof wfDemoGet === 'function';
      if (!real && !demo) return;
      P.push((real ? wfCall(u, 'dt-kq') : wfDemoGet('dt-kq')).then(function (j) { return { n: dtMerge(u, j.list || []), h: dtHnApply(u) }; })
        .catch(function (e) { log('Đào tạo: chưa lấy được kết quả học trên app – ' + (e && e.message || e)); return { n: 0, h: 0 }; }));
    });
    if (!P.length) { if (force) toast('Chưa kết nối app nhân viên', 'info', 'Kết nối máy chủ chấm công ở mục Ứng dụng nhân viên để nhân viên học trên app.'); return; }
    Promise.all(P).then(function (L) {
      var n = 0, h = 0; L.forEach(function (x) { n += x.n; h += x.h; });
      if (n) { dtSave('Cập nhật ' + n + ' lượt học từ app nhân viên'); if (curPage === 'dtketqua' || (curPage === 'dtkhoa' && !(PS.dt && PS.dt.ed))) render(); toast('Đã cập nhật kết quả học trên app', 'ok', n + ' lượt học' + (h ? ' · ' + h + ' bước hội nhập tự hoàn thành' : '')); }
      else if (force) toast('Chưa có lượt học mới trên app', 'info');
