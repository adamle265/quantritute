{
  // Chấm công Wi-Fi – BẢN THỬ NGHIỆM. Worker + database D1 RIÊNG (không dùng chung quantritute-db).
  // database_id do chuan-bi.mjs tự điền khi chạy trien-khai.cmd lần đầu.
  "name": "qtt-cham-cong-thu",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // Chạy ở tên miền phụ của quantritute.com, không mở địa chỉ *.workers.dev (tránh lộ tên miền phụ của tài khoản)
  "workers_dev": false,
  "preview_urls": false,
  "routes": [ { "pattern": "chamcong-thu.quantritute.com", "custom_domain": true } ],
  "d1_databases": [
    { "binding": "DB", "database_name": "qtt-cham-cong-thu-db", "database_id": "9130ffc7-19c8-49b8-b3bb-215bde28611e" }
  ],
  "observability": { "enabled": true }
}
