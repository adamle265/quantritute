{
  // Cổng tuyển dụng – BẢN THỬ NGHIỆM (11/11/2026). Worker riêng.
  // 19:55: database riêng qtt-tuyen-dung-thu-db tạo được nhưng Cloudflare báo lỗi 10021 khi nối vào Worker → dùng chung database chấm công thử
  // (đang nối bình thường), bảng của cổng tuyển dụng đều có tiền tố td_ nên không đụng bảng chấm công. Database qtt-tuyen-dung-thu-db để trống, xóa được.
  "name": "qtt-tuyen-dung-thu",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [ { "pattern": "recruit.quantritute.com", "custom_domain": true } ],
  "d1_databases": [
    { "binding": "DB", "database_name": "qtt-cham-cong-thu-db", "database_id": "9130ffc7-19c8-49b8-b3bb-215bde28611e" }
  ],
  // dọn hồ sơ, CV, trang cổng quá 24 giờ – mỗi giờ 1 lần
  "triggers": { "crons": [ "17 * * * *" ] },
  "observability": { "enabled": true }
}
