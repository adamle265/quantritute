{
  // Cấu hình Cloudflare cho dự án "quantritute-admin". database_id được script setup tự điền.
  "name": "quantritute-admin",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2025-09-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "quantritute-db", "database_id": "f67070cc-9dd8-4c8d-9707-e8078619caf6" }
  ],
  // Workers AI cho nút "Quét ngay" (tóm tắt văn bản pháp luật mới)
  "ai": { "binding": "AI" }
}
