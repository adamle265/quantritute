{
  // Cổng tuyển dụng – BẢN THỬ NGHIỆM (11/11/2026). Worker + database D1 RIÊNG, không dùng chung quantritute-db hay qtt-cham-cong-thu-db.
  // database_id do chuan-bi.mjs tự điền khi chạy trien-khai.cmd lần đầu.
  "name": "qtt-tuyen-dung-thu",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [ { "pattern": "recruit.quantritute.com", "custom_domain": true } ],
  "d1_databases": [
    { "binding": "DB", "database_name": "qtt-tuyen-dung-thu-db", "database_id": "" }
  ],
  // dọn hồ sơ, CV, trang cổng quá 24 giờ – mỗi giờ 1 lần
  "triggers": { "crons": [ "17 * * * *" ] },
  "observability": { "enabled": true }
}
